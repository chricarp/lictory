{
  "name": "lictory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "release": "bun scripts/release.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:data": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check && bun scripts/check-migrations.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:status": "bun scripts/migrate.ts --status",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun scripts/check-pr-assets.ts",
    "auth:generate": "bunx auth@1.7.7 generate --config better-auth.config.ts --adapter drizzle --dialect postgresql --output packages/core/src/db/auth-schema.ts --yes",
    "db:test": "bun test packages/core/src/db/schema.test.ts",
    "test:sync": "bun test packages/core/src/domain",
    "test:e2e": "bun scripts/test-e2e.ts"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@rocicorp/zero": "1.11.2",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/nft": "1.11.0",
    "better-auth": "^1.7.7",
    "better-call": "1.4.0",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "http-proxy-3": "2.0.1",
    "knip": "^6.41.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "tinypool": "2.2.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "@rocicorp/zero-sqlite3",
    "esbuild",
    "protobufjs"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

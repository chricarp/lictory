{
  "name": "lictory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4",
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "release": "bun scripts/release.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:data": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check && bun scripts/check-migrations.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:status": "bun scripts/migrate.ts --status",
    "db:compatibility": "bun scripts/database.ts check",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p .",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=6144 $NODE_OPTIONS\" eslint --concurrency 2 .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "knip": "knip --no-progress",
    "check": "bun scripts/check-toolchain.ts && bun run typecheck && bun run lint && bun run check:rest",
    "check:rest": "bun run format:check && bun run knip && bun scripts/check-pr-assets.ts && bun scripts/configuration-reference.ts --check",
    "config:docs": "bun scripts/configuration-reference.ts",
    "auth:generate": "bunx auth@1.7.7 generate --config better-auth.config.ts --adapter drizzle --dialect postgresql --output packages/core/src/db/auth-schema.ts --yes",
    "db:test": "bun test packages/core/src/db/schema.test.ts",
    "test:sync": "bun test packages/core/src/domain",
    "test:domain": "bun test --parallel --timings=scripts/test-timings/domain.json src",
    "test:e2e": "bun scripts/test-e2e.ts",
    "admin": "bun apps/api/src/admin-cli.ts",
    "test:smoke": "bun scripts/test-e2e.ts --grep @smoke",
    "licenses:report": "bun scripts/license-report.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hocuspocus/provider": "4.7.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@rocicorp/zero": "1.11.3",
    "@tailwindcss/postcss": "^4",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vercel/nft": "1.11.0",
    "better-auth": "^1.7.7",
    "better-call": "1.4.4",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "http-proxy-3": "2.0.2",
    "knip": "^6.43.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "tinypool": "2.2.0",
    "undici": "7.30.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@rocicorp/zero-sqlite3",
    "esbuild",
    "protobufjs",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "MIT"
}

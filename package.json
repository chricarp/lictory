{
  "name": "lictory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "release": "bun scripts/release.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:data": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check && bun scripts/check-migrations.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:status": "bun scripts/migrate.ts --status",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun scripts/check-pr-assets.ts",
    "auth:generate": "bunx auth@1.7.7 generate --config better-auth.config.ts --adapter drizzle --dialect postgresql --output src/db/auth-schema.ts --yes",
    "db:test": "bun test src/db/schema.test.ts",
    "test:sync": "bun test src/sync",
    "test:e2e": "bun scripts/test-e2e.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.131",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@c15t/nextjs": "2.2.1",
    "@c15t/scripts": "2.2.0",
    "@firecrawl/anydoc": "^0.2.4",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "ai": "^7.0.128",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.3",
    "loading-dev": "^0.3.5",
    "lucide-react": "^1.47.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "posthog-node": "^5.54.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "@next/eslint-plugin-next@16.3.8": "patches/@next%2Feslint-plugin-next@16.3.8.patch"
  }
}

#!/usr/bin/env bash
# lictory: install and operate a self-hosted Lictory environment on this
# server. A thin layer over the release tooling (install.sh,
# new-environment.sh, deploy.sh, lictory-compose, lictory-backup,
# lictory-restore-drill): it guides a first installation (server checks,
# address, services, access policy, the first administrator), pulls releases
# from GitHub Releases and surfaces the safeguards of deploy.sh. Instance
# administration runs inside the api container (apps/api/dist/admin.js).
# Installed by deploy/get.sh; see docs/operations/self-hosting.md.
#
#   lictory install                 guided (or --yes with flags/LICTORY_* variables)
#   lictory admin <command>         first administrator, accounts and instance administrators
#   lictory status [--json]         active release, service health and access policy
#   lictory doctor                  host and runtime checks, with what to fix
#   lictory database check|setup    database requirements; roles on an external database
#   lictory upgrade [version]       newest release of the environment's channel, or that version
#   lictory rollback                re-activate the previous release's images
#   lictory backup                  encrypted backup now
#   lictory restore <identity|none> [latest|<key>|<file>] [--drill]
#   lictory logs [service] [-f] [--tail N]
#   lictory registry-login [--username U]   token on stdin, for private images
#
# Every command takes --env <name> when the server hosts several environments.
# Output is styled only on a terminal (NO_COLOR=1 turns colours off); logs and
# pipes get plain text.
set -euo pipefail

repository="${LICTORY_REPOSITORY:-chricarp/lictory}"
github_api="${LICTORY_GITHUB_API:-https://api.github.com}"
default_registry="${LICTORY_DEFAULT_REGISTRY:-ghcr.io/chricarp}"
root="${LICTORY_ROOT:-/srv/lictory}"
cli_path="${LICTORY_CLI_PATH:-/usr/local/bin/lictory}"
# The services of an environment; an external database has no container here.
all_services="postgres zero-cache api worker proxy"
services_of_environment() {
  if [ "$(setting LICTORY_DATABASE)" = external ]; then echo "zero-cache api worker proxy"; else echo "$all_services"; fi
}
# Placeholder for ACME_EMAIL, which Compose requires even when the gateway
# requests no certificates (proxy, local CA and plain HTTP modes).
unused_email=unused@example.invalid

# ------------------------------------------------------------------- terminal
# Styling needs a terminal on both outputs; everything else gets the plain
# text earlier versions printed, so logs and scripts keep working.
fancy=false
if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ] && [ -t 1 ] && [ -t 2 ]; then
  fancy=true
fi
utf8=false
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) utf8=true ;; esac
if [ "$fancy" = true ]; then
  c_reset=$'\033[0m' c_bold=$'\033[1m' c_dim=$'\033[2m' c_red=$'\033[31m'
  c_green=$'\033[32m' c_yellow=$'\033[33m' c_accent=$'\033[38;5;105m'
else
  c_reset="" c_bold="" c_dim="" c_red="" c_green="" c_yellow="" c_accent=""
fi
if [ "$fancy" = true ] && [ "$utf8" = true ]; then
  g_ok="✓" g_warn="!" g_fail="✗" g_step="◆" g_prompt="›" g_pointer="❯" g_on="●" g_off="○"
  g_bullet="•" g_mask="••••" g_h="─" g_v="│" g_tl="╭" g_tr="╮" g_bl="╰" g_br="╯" g_ellipsis="…"
  spinner_frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
else
  g_ok="ok" g_warn="!" g_fail="x" g_step="==" g_prompt=">" g_pointer=">" g_on="(*)" g_off="( )"
  g_bullet="-" g_mask="****" g_h="-" g_v="|" g_tl="+" g_tr="+" g_bl="+" g_br="+" g_ellipsis="..."
  spinner_frames=('|' '/' '-' '\')
fi

columns() {
  local width="${COLUMNS:-}"
  [ -n "$width" ] || width=$(tput cols 2>/dev/null || echo 80)
  [[ "$width" =~ ^[0-9]+$ ]] || width=80
  [ "$width" -le 100 ] || width=100
  printf '%s' "$width"
}
repeat() { # repeat <text> <count>
  local i out=""
  for ((i = 0; i < $2; i++)); do out="$out$1"; done
  printf '%s' "$out"
}

say() { printf '%s\n' "$*"; }
# Step headers: "Step 3 of 8 · Access policy" when the command counts steps.
steps_total=0
step_index=0
step() {
  local counter=""
  if [ "$steps_total" -gt 0 ]; then
    step_index=$((step_index + 1))
    counter="Step $step_index of $steps_total"
  fi
  if [ "$fancy" = true ]; then
    printf '\n %s%s%s %s%s%s%s%s\n' "$c_accent" "$g_step" "$c_reset" "$c_dim" "${counter:+$counter · }" "$c_reset$c_bold" "$*" "$c_reset"
    printf ' %s%s%s\n' "$c_dim" "$(repeat "$g_h" $(($(columns) - 2)))" "$c_reset"
  else
    printf '\n== %s%s\n' "${counter:+[$step_index/$steps_total] }" "$*"
  fi
}
note() { # a secondary line: dimmed on a terminal
  if [ "$fancy" = true ]; then printf '   %s%s%s\n' "$c_dim" "$*" "$c_reset"; else say "$*"; fi
}
warn() {
  if [ "$fancy" = true ]; then
    printf '   %s%s Warning:%s %s\n' "$c_yellow" "$g_warn" "$c_reset" "$*" >&2
  else
    printf 'Warning: %s\n' "$*" >&2
  fi
}
die() {
  if [ "$fancy" = true ]; then
    printf '\n %s%s Error:%s %s\n' "$c_red$c_bold" "$g_fail" "$c_reset" "$1" >&2
  else
    printf 'Error: %s\n' "$1" >&2
  fi
  exit "${2:-1}"
}
usage_error() {
  printf 'Error: %s\nRun "lictory help" for usage.\n' "$1" >&2
  exit 64
}

# banner <subtitle>: the Lictory header (terminal only).
banner() {
  [ "$fancy" = true ] || return 0
  local version
  version=$(current_version 2>/dev/null || true)
  [ -n "$version" ] || version=$(env_value "$root/share/bundle/release.env" LICTORY_VERSION 2>/dev/null || true)
  box "${c_accent}${g_step}${c_reset} ${c_bold}Lictory${c_reset}  ${c_dim}$1${c_reset}" \
    "${c_dim}${version:+release $version · }environment ${environment:-production} · $(hostname 2>/dev/null || echo server)${c_reset}"
}

# box <line...>: lines in a rounded frame on a terminal, plain lines otherwise.
# Lines may carry colour codes; widths are measured without them.
box() {
  local line plain width=0 inner cols
  if [ "$fancy" != true ]; then
    for line in "$@"; do say "$line"; done
    return 0
  fi
  cols=$(columns)
  for line in "$@"; do
    plain=$(printf '%s' "$line" | sed $'s/\033\\[[0-9;]*m//g')
    [ "${#plain}" -le "$width" ] || width=${#plain}
  done
  inner=$((width + 2))
  [ "$inner" -le $((cols - 4)) ] || inner=$((cols - 4))
  printf '\n %s%s%s%s%s\n' "$c_dim" "$g_tl" "$(repeat "$g_h" "$inner")" "$g_tr" "$c_reset"
  for line in "$@"; do
    plain=$(printf '%s' "$line" | sed $'s/\033\\[[0-9;]*m//g')
    # Too long for the terminal: the plain text, shortened.
    if [ "${#plain}" -gt $((inner - 2)) ]; then
      plain="${plain:0:$((inner - 3))}$g_ellipsis"
      line="$plain"
    fi
    printf ' %s%s%s %s%*s %s%s%s\n' "$c_dim" "$g_v" "$c_reset" "$line" $((inner - 2 - ${#plain} > 0 ? inner - 2 - ${#plain} : 0)) "" "$c_dim" "$g_v" "$c_reset"
  done
  printf ' %s%s%s%s%s\n' "$c_dim" "$g_bl" "$(repeat "$g_h" "$inner")" "$g_br" "$c_reset"
}
# row <label> <value>: one aligned line for a box or plain output.
row() { printf '%s%-24s%s %s' "$c_dim" "$1" "$c_reset" "$2"; }

usage() {
  cat <<'USAGE'
Usage: lictory <command> [options]

  install            Install or reconfigure an environment (guided, or --yes)
  admin <command>    Instance administration (lictory admin help)
  status [--json]    Active release, service health and access policy
  doctor             Check the host and the running environment
  database check     Check the database against Lictory's requirements (--json)
  database setup     Create Lictory's roles on an external database
                     (administrator URL from LICTORY_DATABASE_ADMIN_URL or a prompt)
  upgrade [version]  Upgrade to the newest release of the channel, or to <version>
  rollback           Re-activate the previous release (database schema stays)
  backup             Take an encrypted backup now
  restore <identity-file|none> [latest|<key>|<file>]
                     Replace the database with a backup (--drill: test only)
  logs [service]     Service logs (-f to follow, --tail N)
  registry-login     Log in to the image registry (token on stdin)
  help               This text

Options for every command: --env <name> (when several environments exist),
--yes (no questions). Install options: docs/operations/self-hosting.md.
USAGE
}

admin_usage() {
  cat <<'USAGE'
Usage: lictory admin <command> [options]

  setup                    Create the first administrator and their organization
                           (--organization, --organization-handle, --admin-name,
                           --admin-email; password from LICTORY_ADMIN_PASSWORD)
  status [--json]          Access policy, administrators, accounts, organizations
  list                     Instance administrators
  grant <email>            Make an account an instance administrator
  revoke <email>           Remove instance administration from an account
  create-user <email>      Create an account (--name, --admin, --organization
                           <handle> [--role member|admin|owner]; password at the
                           prompt or from LICTORY_USER_PASSWORD, else none)
  set-password <email>     Set a password and sign the account out everywhere
                           (prompt, or LICTORY_USER_PASSWORD)
  deactivate <email>       Block sign-in and end every session (reversible)
  reactivate <email>       Allow a deactivated account to sign in again

Instance administrators manage accounts and organizations in the admin
console at <your address>/admin. These commands work from the server even
when nobody can sign in, for example to recover the only administrator.
USAGE
}

# ------------------------------------------------------------- option parsing
# Options are stored as opt_<name>; "given" records which ones were supplied
# (on the command line, by a LICTORY_<NAME> variable or answered at a prompt).
given=" "
set_opt() {
  local var
  var="opt_$(printf '%s' "$1" | tr '-' '_')"
  printf -v "$var" '%s' "$2"
  case "$given" in *" $1 "*) ;; *) given="$given$1 " ;; esac
}
opt() {
  local var
  var="opt_$(printf '%s' "$1" | tr '-' '_')"
  printf '%s' "${!var:-}"
}
is_given() { case "$given" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
word_in() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

install_values="host tls acme-email acme-ca http-port bind public-url trusted-proxies
  database database-host database-port database-sslmode database-ca-file database-admin-url
  email smtp-host smtp-port smtp-user smtp-password smtp-from resend-api-key email-from
  storage s3-endpoint s3-region s3-bucket s3-access-key-id s3-secret-access-key s3-force-path-style
  oidc oidc-issuer oidc-client-id oidc-client-secret oidc-display-name
  backup backup-path backup-bucket backup-s3-provider backup-s3-endpoint backup-s3-region
  backup-s3-access-key-id backup-s3-secret-access-key backup-rclone-remote
  backup-age-recipient backup-identity-file channel version deploy-user
  signup-mode allowed-email-domains organization-creation
  organization organization-handle admin-name admin-email"

positional=()
parse() { # parse <value options> <flag options> <arguments...>
  local values="env $1" flags="yes help $2" name value has_value
  values=$(printf '%s' "$values" | tr -s ' \n' '  ')
  shift 2
  positional=()
  while [ $# -gt 0 ]; do
    has_value=false
    case "$1" in
      --)
        shift
        positional+=("$@")
        break
        ;;
      --*=*)
        name="${1%%=*}"
        name="${name#--}"
        value="${1#*=}"
        has_value=true
        ;;
      --*) name="${1#--}" ;;
      -y) name=yes ;;
      -h) name=help ;;
      -f) name=follow ;;
      -e) name="env" ;;
      -?*) usage_error "Unknown option: $1" ;;
      *)
        positional+=("$1")
        shift
        continue
        ;;
    esac
    if word_in "$name" "$flags"; then
      [ "$has_value" = false ] || usage_error "--$name takes no value."
      set_opt "$name" true
      shift
    elif word_in "$name" "$values"; then
      if [ "$has_value" = false ]; then
        [ $# -ge 2 ] || usage_error "--$name needs a value."
        value="$2"
        shift
      fi
      shift
      set_opt "$name" "$value"
    else
      usage_error "Unknown option for lictory $command: --$name"
    fi
  done
  # LICTORY_<NAME> variables supply options not given on the command line
  # (secrets stay out of the process list and shell history).
  local env_name
  for name in $values; do
    is_given "$name" && continue
    env_name="LICTORY_$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')"
    [ -z "${!env_name:-}" ] || set_opt "$name" "${!env_name}"
  done
  for name in $values; do
    is_given "$name" || continue
    value=$(opt "$name")
    reason=$(invalid_reason "$name" "$value") || true
    [ -z "$reason" ] || usage_error "--$name: $reason"
  done
  if [ "$(opt help)" = true ]; then
    usage
    exit 0
  fi
}

# ----------------------------------------------------------------- validation
host_pattern='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
version_pattern='^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'
origin_pattern='^https?://([a-z0-9.-]+|\[[0-9a-f:]+\])(:[0-9]+)?$'
age_pattern='^age1[0-9a-z]{20,}([ ,]+age1[0-9a-z]{20,})*$'
email_pattern='^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$'
domain_pattern='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'

valid_environment() {
  [[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]] && case "$1" in local | test | preview) false ;; esac
}
# Organization handles are URL names (packages/core/src/lib/organization-handles.ts):
# the server checks reserved names; this catches typing mistakes early.
handle_problem() {
  local handle="$1"
  if [ "${#handle}" -lt 3 ] || [ "${#handle}" -gt 30 ]; then
    echo "3 to 30 characters"
  elif ! [[ "$handle" =~ ^[a-z][a-z0-9_-]*$ ]] || [[ "$handle" =~ [-_][-_] ]] || [[ "$handle" =~ [-_]$ ]]; then
    echo "lowercase letters, digits, single hyphens or underscores, starting with a letter"
  fi
}
# A handle suggestion from an organization name (as the app suggests it).
suggest_handle() {
  local ascii
  ascii=$(printf '%s' "$1" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null) || ascii="$1"
  printf '%s' "$ascii" | tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^[^a-z]+//' | cut -c1-30 | sed -E 's/-+$//' || true
}
valid_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

# Prints why <value> is not acceptable for option <name>; nothing when it is.
invalid_reason() {
  local name="$1" value="$2" item
  case "$value" in
    *$'\n'* | *$'\r'*) echo "must be a single line" && return ;;
    *"'"*) echo "must not contain a single quote (edit .env by hand for such values)" && return ;;
  esac
  case "$name" in
    env) valid_environment "$value" || echo "use lowercase letters, digits and hyphens (local, test and preview are reserved)" ;;
    host) [[ "$value" =~ $host_pattern ]] || echo "a lowercase host name such as lictory.example.com (no scheme, port or path)" ;;
    tls) word_in "$value" "acme proxy internal http" || echo "one of acme, proxy, internal, http" ;;
    acme-email) [[ "$value" =~ $email_pattern ]] || echo "an email address" ;;
    acme-ca | oidc-issuer) [ -z "$value" ] || [[ "$value" =~ ^https://[^[:space:]]+$ ]] || echo "an https:// URL" ;;
    http-port | smtp-port | database-port) valid_port "$value" || echo "a port number" ;;
    database) word_in "$value" "bundled external" || echo "bundled or external" ;;
    database-host) [[ "$value" =~ $host_pattern ]] || [[ "$value" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] ||
      echo "a lowercase host name or IPv4 address (the direct endpoint; no scheme, port or path)" ;;
    database-sslmode) word_in "$value" "verify-full require" || echo "verify-full (recommended) or require" ;;
    database-ca-file) [ -z "$value" ] || [[ "$value" =~ ^/[A-Za-z0-9._/-]+$ ]] || echo "an absolute path without spaces" ;;
    database-admin-url) [[ "$value" =~ ^postgres(ql)?://[^[:space:]]+$ ]] || echo "a postgresql:// URL" ;;
    bind) word_in "$value" "127.0.0.1 0.0.0.0" || echo "127.0.0.1 (this host only) or 0.0.0.0 (all interfaces)" ;;
    public-url) [[ "$value" =~ $origin_pattern ]] || echo "an origin such as https://lictory.example.com (lowercase, no path or trailing slash)" ;;
    trusted-proxies)
      for item in $value; do
        [[ "$item" =~ ^[0-9a-fA-F:.]+(/[0-9]{1,3})?$ ]] || { echo "space-separated IP addresses or CIDRs" && return; }
      done
      ;;
    email) word_in "$value" "smtp resend none" || echo "one of smtp, resend, none" ;;
    storage) word_in "$value" "s3 none" || echo "s3 or none" ;;
    s3-endpoint | backup-s3-endpoint) [ -z "$value" ] || [[ "$value" =~ ^https?://[^/[:space:]@]+$ ]] || echo "an http(s)://host[:port] URL without a path" ;;
    s3-force-path-style) word_in "$value" "true false" || echo "true or false" ;;
    oidc) word_in "$value" "yes no" || echo "yes or no" ;;
    backup) word_in "$value" "local s3 rclone none" || echo "one of local, s3, rclone, none" ;;
    backup-path | backup-identity-file) [ -z "$value" ] || [[ "$value" =~ ^/[A-Za-z0-9._/-]+$ ]] || echo "an absolute path without spaces" ;;
    backup-age-recipient) [[ "$value" =~ $age_pattern ]] || word_in "$value" "none generate" || echo "an age public key (age1…), generate or none" ;;
    channel) word_in "$value" "stable nightly" || echo "stable or nightly" ;;
    version) [[ "$value" =~ $version_pattern ]] || echo "a release version such as 1.4.2" ;;
    deploy-user | username) [[ "$value" =~ ^[A-Za-z0-9_][A-Za-z0-9._@+\$-]{0,127}$ ]] || echo "a user name" ;;
    signup-mode) word_in "$value" "invite closed open" || echo "one of invite, closed, open" ;;
    organization-creation) word_in "$value" "administrators everyone" || echo "administrators or everyone" ;;
    allowed-email-domains)
      for item in ${value//,/ }; do
        # tr, not ${item,,}: macOS ships bash 3.2.
        [[ "$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')" =~ $domain_pattern ]] || { echo "comma-separated lowercase email domains such as example.com" && return; }
      done
      ;;
    admin-email | user-email) [[ "$value" =~ $email_pattern ]] || echo "an email address" ;;
    admin-name | name) [ "${#value}" -le 100 ] || echo "at most 100 characters" ;;
    organization) [ "${#value}" -le 80 ] || echo "at most 80 characters" ;;
    organization-handle) handle_problem "$value" ;;
    role) word_in "$value" "member admin owner" || echo "member, admin or owner" ;;
    tail) [[ "$value" =~ ^[0-9]{1,6}$ ]] || echo "a number of lines" ;;
  esac
}

# -------------------------------------------------------------- environment
valid_root() { [[ "$root" =~ ^/[A-Za-z0-9._/-]+$ ]] && [[ "$root" != *..* ]]; }
valid_root || die "LICTORY_ROOT must be an absolute path without spaces or '..'." 64
root="${root%/}"
bin="$root/bin"

env_value() { # env_value <file> <key> (the last assignment, one pair of quotes removed)
  local line
  line=$(grep -E "^$2=" "$1" 2>/dev/null | tail -n 1 || true)
  line="${line#*=}"
  line="${line%\"}"
  line="${line#\"}"
  line="${line%\'}"
  line="${line#\'}"
  printf '%s' "$line"
}
setting() { env_value "$home/.env" "$1"; }

configured_environments() {
  local file
  for file in "$root"/*/.env; do
    [ -f "$file" ] || continue
    basename "$(dirname "$file")"
  done
}

# select_environment [install]: --env, else the only configured environment.
select_environment() {
  local found count
  environment=$(opt env)
  if [ -z "$environment" ]; then
    found=$(configured_environments 2>/dev/null || true)
    count=$(printf '%s' "$found" | grep -c . || true)
    if [ "$count" = 1 ]; then
      environment="$found"
    elif [ "$count" = 0 ] && [ "${1:-}" = install ]; then
      environment=production
    elif [ "$count" = 0 ]; then
      die "No Lictory environment is configured under $root. Run: sudo lictory install"
    else
      die "This server hosts several environments ($(printf '%s' "$found" | tr '\n' ' ' | sed 's/ $//')): pass --env <name>." 64
    fi
  fi
  home="$root/$environment"
  if [ "${1:-}" != install ]; then
    [ -r "$home/.env" ] || {
      [ -e "$home/.env" ] && die "Cannot read $home/.env: run with sudo or as the deploy user."
      die "Environment $environment is not configured ($home/.env does not exist). Run: sudo lictory install --env $environment"
    }
  fi
}

is_root() { [ "$(id -u)" = 0 ]; }
require_root() { is_root || die "Run as root: sudo lictory $command"; }
owner_of() { stat -c %U "$1" 2>/dev/null || stat -f %Su "$1"; }
deploy_user() {
  if [ -n "$(opt deploy-user)" ]; then
    opt deploy-user
  elif [ -n "${DEPLOY_USER:-}" ]; then
    printf '%s' "$DEPLOY_USER"
  elif [ -d "$root" ]; then
    owner_of "$root"
  else
    printf deploy
  fi
}
# Release tooling runs as the deploy user, so files it creates stay
# writable by the timers (systemd runs them as that user).
as_deploy() {
  if ! is_root; then
    env LICTORY_ROOT="$root" "$@"
    return
  fi
  local user
  user=$(deploy_user)
  if command -v runuser >/dev/null; then
    runuser -u "$user" -- env LICTORY_ROOT="$root" "$@"
  elif command -v sudo >/dev/null; then
    sudo -H --preserve-env=RESTORE_PGPASSWORD,DATABASE_ADMIN_URL -u "$user" env LICTORY_ROOT="$root" "$@"
  else
    die "Neither runuser nor sudo is available to run commands as $user."
  fi
}
deploy_sh() { as_deploy "$bin/deploy.sh" "$environment" "$@"; }
compose() { as_deploy "$bin/lictory-compose" "$environment" "$@"; }

current_version() {
  [ -f "$home/current/release.env" ] || return 0
  env_value "$home/current/release.env" LICTORY_VERSION
}
platform_url() {
  local url host
  url=$(setting PLATFORM_URL)
  host=$(setting PUBLIC_APP_HOST)
  host="${host:-$(setting APP_HOST)}"
  printf '%s' "${url:-https://$host}"
}
channel_of_environment() {
  local channel
  channel=$(setting LICTORY_RELEASE_CHANNEL)
  printf '%s' "${channel:-stable}"
}

# Writes KEY=VALUE into an .env file: replaces existing assignments, appends
# new keys, leaves every other line (comments, secrets) untouched. Values
# with `$` or `#` are single-quoted for Compose.
set_env() { # set_env <file> <key> <value>
  local file="$1" key="$2" value="$3" tmp
  if ! grep -qE "^$key=" "$file"; then
    [ -n "$value" ] || return 0
    printf '%s=%s\n' "$key" "$(env_quote "$value")" >>"$file"
    return 0
  fi
  tmp=$(mktemp "$(dirname "$file")/.env.XXXXXX")
  LICTORY_KEY="$key" LICTORY_VALUE="$(env_quote "$value")" awk '
    BEGIN { key = ENVIRON["LICTORY_KEY"]; value = ENVIRON["LICTORY_VALUE"] }
    index($0, key "=") == 1 { print key "=" value; next }
    { print }
  ' "$file" >"$tmp"
  chmod 0600 "$tmp"
  is_root && chown "$(owner_of "$file")" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$file"
}
env_quote() {
  case "$1" in
    *'$'* | *'#'* | ' '* | *' ' | '"'*) printf "'%s'" "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# ------------------------------------------------------------------- releases
api_get() { # api_get <path> <output file>; prints the HTTP status
  local headers status
  headers=$(mktemp)
  chmod 0600 "$headers"
  printf 'Accept: application/vnd.github+json\nX-GitHub-Api-Version: 2022-11-28\n' >"$headers"
  [ -z "${GITHUB_TOKEN:-}" ] || printf 'Authorization: Bearer %s\n' "$GITHUB_TOKEN" >>"$headers"
  status=$(curl -sSL --proto '=https' --proto-redir '=https' --tlsv1.2 -m 30 --retry 3 \
    -H "@$headers" -o "$2" -w '%{http_code}' "$github_api/repos/$repository$1" || echo 000)
  rm -f "$headers"
  printf '%s' "$status"
}

nightly_tag='^v[0-9]+\.[0-9]+\.[0-9]+-nightly\.[0-9]{8}\.[0-9]+$'
stable_tag='^v[0-9]+\.[0-9]+\.[0-9]+$'

# resolve_release <channel> [version]: sets release_tag, release_version,
# release_notes, release_asset_url and release_digest.
resolve_release() {
  local channel="$1" version="${2:-}" json status path
  json=$(mktemp)
  if [ -n "$version" ]; then
    path="/releases/tags/v${version#v}"
  elif [ "$channel" = stable ]; then
    path=/releases/latest
  else
    path="/releases?per_page=50"
  fi
  status=$(api_get "$path" "$json")
  case "$status" in
    200) ;;
    404)
      rm -f "$json"
      [ -n "$version" ] && die "Release ${version#v} of $repository does not exist: https://github.com/$repository/releases"
      die "No $channel release of $repository is published yet. Choose another channel (--channel nightly) or a version."
      ;;
    403 | 429)
      rm -f "$json"
      die "GitHub refused the request (HTTP $status, usually its rate limit for anonymous requests). Retry later, or set GITHUB_TOKEN."
      ;;
    *)
      rm -f "$json"
      die "Could not reach GitHub Releases ($github_api, HTTP $status). Check this server's outbound HTTPS access."
      ;;
  esac
  if [ -z "$version" ] && [ "$channel" = nightly ]; then
    jq --arg pattern "$nightly_tag" '
      [.[] | select(.draft == false and .prerelease == true and (.tag_name | test($pattern)))]
      | sort_by(.published_at) | last // empty' "$json" >"$json.one" && mv "$json.one" "$json"
    [ -s "$json" ] || {
      rm -f "$json"
      die "No nightly release of $repository is published yet."
    }
  fi
  release_tag=$(jq -r '.tag_name // ""' "$json")
  release_notes=$(jq -r '.html_url // ""' "$json")
  release_asset_url=$(jq -r '[.assets[]? | select(.name == "release.env")][0].browser_download_url // ""' "$json")
  release_digest=$(jq -r '[.assets[]? | select(.name == "release.env")][0].digest // ""' "$json")
  local draft prerelease
  draft=$(jq -r '.draft' "$json")
  prerelease=$(jq -r '.prerelease' "$json")
  rm -f "$json"
  [ "$draft" = false ] || die "$release_tag is a draft, not a published release."
  if [[ "$release_tag" =~ $stable_tag ]] && [ "$prerelease" = false ]; then
    release_channel=stable
  elif [[ "$release_tag" =~ $nightly_tag ]] && [ "$prerelease" = true ]; then
    release_channel=nightly
  else
    die "$release_tag is not a Lictory stable or nightly release."
  fi
  [ "$release_channel" = "$channel" ] ||
    die "${release_tag#v} is a $release_channel release; environment $environment follows $channel releases (LICTORY_RELEASE_CHANNEL in $home/.env)."
  release_version="${release_tag#v}"
  [ -n "$release_asset_url" ] || die "Release $release_version has no release.env asset; it cannot be installed with this tool."
  [[ "$release_asset_url" =~ ^https:// ]] || die "Release $release_version has an unexpected asset URL."
}

sha256_of() { openssl dgst -sha256 -r "$1" | cut -d' ' -f1 | tr -d '*'; }

# fetch_release <output file>: downloads the resolved release.env, verifies
# it against GitHub's asset digest and checks it names the resolved release.
fetch_release() {
  local file="$1" actual
  curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 -m 60 --retry 3 \
    -o "$file" "$release_asset_url" || die "Could not download release.env of $release_version."
  if [ -n "$release_digest" ]; then
    actual="sha256:$(sha256_of "$file")"
    [ "$actual" = "$release_digest" ] ||
      die "release.env of $release_version does not match the digest GitHub publishes ($release_digest, downloaded $actual). Nothing was installed."
  else
    warn "GitHub publishes no digest for release.env of $release_version; relying on HTTPS alone."
  fi
  [ "$(env_value "$file" LICTORY_VERSION)" = "$release_version" ] ||
    die "release.env of $release_tag names version $(env_value "$file" LICTORY_VERSION)."
  [ "$(env_value "$file" LICTORY_CHANNEL)" = "$release_channel" ] ||
    die "release.env of $release_tag names channel $(env_value "$file" LICTORY_CHANNEL)."
}

# Pulls a release's images as the deploy user (deploy.sh pulls again from the
# cache) to turn registry refusals into an actionable message.
pull_release_images() { # pull_release_images <release file>
  local file="$1" key image output
  for key in OPS_IMAGE API_IMAGE PROXY_IMAGE MIGRATE_IMAGE; do
    image=$(env_value "$file" "$key")
    [ -n "$image" ] || die "The release file has no $key."
    if ! output=$(as_deploy docker pull -q "$image" 2>&1); then
      case "$output" in
        *denied* | *unauthorized* | *forbidden* | *"authentication required"*)
          die "The registry refused to pull $image.
The Lictory images may not be public yet. Log in with a token that can read
packages, then retry:  sudo lictory registry-login --username <github-user>" ;;
        *) die "Could not pull $image: $output" ;;
      esac
    fi
  done
}

# semver_cmp <a> <b>: prints -1, 0 or 1 (prerelease identifiers per SemVer).
semver_cmp() {
  local a="$1" b="$2" a_pre="" b_pre="" i x y
  [[ "$a" == *-* ]] && a_pre="${a#*-}"
  [[ "$b" == *-* ]] && b_pre="${b#*-}"
  local IFS=.
  local -a ac bc ap bp
  read -r -a ac <<<"${a%%-*}"
  read -r -a bc <<<"${b%%-*}"
  for i in 0 1 2; do
    x=$((10#${ac[i]:-0}))
    y=$((10#${bc[i]:-0}))
    [ "$x" -gt "$y" ] && echo 1 && return
    [ "$x" -lt "$y" ] && echo -1 && return
  done
  [ -z "$a_pre" ] && [ -z "$b_pre" ] && echo 0 && return
  [ -z "$a_pre" ] && echo 1 && return
  [ -z "$b_pre" ] && echo -1 && return
  read -r -a ap <<<"$a_pre"
  read -r -a bp <<<"$b_pre"
  i=0
  while :; do
    x="${ap[i]:-}"
    y="${bp[i]:-}"
    [ -z "$x" ] && [ -z "$y" ] && echo 0 && return
    [ -z "$x" ] && echo -1 && return
    [ -z "$y" ] && echo 1 && return
    if [[ "$x" =~ ^[0-9]+$ ]] && [[ "$y" =~ ^[0-9]+$ ]]; then
      [ $((10#$x)) -gt $((10#$y)) ] && echo 1 && return
      [ $((10#$x)) -lt $((10#$y)) ] && echo -1 && return
    elif [[ "$x" =~ ^[0-9]+$ ]]; then
      echo -1 && return
    elif [[ "$y" =~ ^[0-9]+$ ]]; then
      echo 1 && return
    else
      [[ "$x" > "$y" ]] && echo 1 && return
      [[ "$x" < "$y" ]] && echo -1 && return
    fi
    i=$((i + 1))
  done
}

# The bundle (install.sh, templates, timers) of the newest release on this
# server: the environment's active release, else the copy get.sh installed.
bundle_dir() {
  if [ -f "$home/current/bundle/provision/install.sh" ]; then
    printf '%s' "$home/current/bundle"
  elif [ -f "$root/share/bundle/provision/install.sh" ]; then
    printf '%s' "$root/share/bundle"
  else
    die "No installation bundle under $root/share. Run the bootstrap first:
  curl -fsSL https://raw.githubusercontent.com/$repository/main/deploy/get.sh | sudo sh"
  fi
}

# Keeps <root>/share/bundle at the active release, for later installs.
refresh_share() {
  [ -f "$home/current/bundle/provision/install.sh" ] || return 0
  as_deploy sh -c 'set -e
    rm -rf "$1/share/.bundle.new"
    mkdir -p "$1/share"
    cp -R "$2/bundle" "$1/share/.bundle.new"
    cp "$2/release.env" "$1/share/.bundle.new/release.env"
    rm -rf "$1/share/bundle"
    mv "$1/share/.bundle.new" "$1/share/bundle"' refresh "$root" "$home/current" ||
    warn "Could not refresh $root/share/bundle."
}

confirm() { # confirm <question>: true with --yes, else asks (default yes)
  [ "$(opt yes)" = true ] && return 0
  [ -t 0 ] || die "Not confirmed: pass --yes to run without questions."
  local answer
  if [ "$fancy" = true ]; then
    printf '\n %s?%s %s%s%s %s(Y/n)%s %s%s%s ' "$c_accent" "$c_reset" "$c_bold" "$1" "$c_reset" "$c_dim" "$c_reset" "$c_accent" "$g_prompt" "$c_reset" >/dev/tty
  else
    printf '%s [Y/n] ' "$1" >/dev/tty
  fi
  IFS= read -r answer </dev/tty || true
  case "$answer" in "" | y | Y | yes | Yes) return 0 ;; *) return 1 ;; esac
}

# run_task <title> <command...>: on a terminal in a guided run, a spinner with
# the elapsed time while the command's output goes to a private log, and the
# log's tail when it fails. Otherwise the output streams as it always did.
task_log=""
run_task() {
  local title="$1" status=0 pid start elapsed frame=0
  shift
  if [ "$fancy" != true ] || [ "$interactive" != true ]; then
    "$@" || status=$?
    return "$status"
  fi
  if [ -z "$task_log" ]; then
    if [ -d "$home" ] && { [ -d "$home/logs" ] || mkdir -m 0700 "$home/logs" 2>/dev/null; }; then
      task_log="$home/logs/$command-$(date -u +%Y%m%dT%H%M%SZ).log"
    else
      task_log=$(mktemp "${TMPDIR:-/tmp}/lictory-$command.XXXXXX")
    fi
    (umask 077 && : >>"$task_log")
  fi
  printf '\n### %s (%s)\n' "$title" "$(date -u +%FT%TZ)" >>"$task_log"
  start=$(date +%s)
  "$@" <&0 >>"$task_log" 2>&1 &
  pid=$!
  # shellcheck disable=SC2064 # the child's pid is fixed now
  trap "kill $pid 2>/dev/null; printf '\033[?25h\n' >&2; exit 130" INT TERM
  printf '\033[?25l' >&2
  while kill -0 "$pid" 2>/dev/null; do
    elapsed=$(($(date +%s) - start))
    printf '\r   %s%s%s %s %s%ss%s\033[K' "$c_accent" "${spinner_frames[frame]}" "$c_reset" "$title" "$c_dim" "$elapsed" "$c_reset" >&2
    frame=$(((frame + 1) % ${#spinner_frames[@]}))
    sleep 0.1
  done
  wait "$pid" || status=$?
  trap - INT TERM
  elapsed=$(($(date +%s) - start))
  printf '\r\033[K\033[?25h' >&2
  if [ "$status" -eq 0 ]; then
    printf '   %s%s%s %s %s%ss%s\n' "$c_green" "$g_ok" "$c_reset" "$title" "$c_dim" "$elapsed" "$c_reset"
  else
    printf '   %s%s%s %s %s(failed after %ss)%s\n' "$c_red" "$g_fail" "$c_reset" "$title" "$c_dim" "$elapsed" "$c_reset"
    tail -n 25 "$task_log" | sed "s/^/     $c_dim$g_v$c_reset /" >&2
    printf '     %sFull log: %s%s\n' "$c_dim" "$task_log" "$c_reset" >&2
  fi
  return "$status"
}

start_timers() {
  [ -d /run/systemd/system ] && command -v systemctl >/dev/null || return 0
  is_root || return 0
  systemctl start "lictory-backup@$environment.timer" "lictory-monitor@$environment.timer" ||
    warn "Could not start the backup and monitor timers (systemctl start lictory-backup@$environment.timer lictory-monitor@$environment.timer)."
}

# wait_until_ready <seconds>: the public /readyz through DNS and certificates.
wait_until_ready() {
  local url deadline insecure=()
  url="$(platform_url)/readyz"
  [ -z "$(setting CADDY_GLOBAL_OPTIONS)" ] || insecure=(-k)
  deadline=$(($(date +%s) + $1))
  while :; do
    curl -fsS ${insecure[@]+"${insecure[@]}"} -m 10 -o /dev/null "$url" 2>/dev/null && return 0
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 5
  done
}

# ------------------------------------------------------------------ preflight
failures=0
warnings=0
check_ok() {
  if [ "$fancy" = true ]; then printf '   %s%s%s %s\n' "$c_green" "$g_ok" "$c_reset" "$*"; else printf '  ok    %s\n' "$*"; fi
}
check_warn() {
  if [ "$fancy" = true ]; then printf '   %s%s %s%s\n' "$c_yellow" "$g_warn" "$*" "$c_reset"; else printf '  warn  %s\n' "$*"; fi
  warnings=$((warnings + 1))
}
check_fail() {
  if [ "$fancy" = true ]; then printf '   %s%s %s%s\n' "$c_red" "$g_fail" "$*" "$c_reset"; else printf '  FAIL  %s\n' "$*"; fi
  failures=$((failures + 1))
}
version_ge() { # version_ge <have> <need>: dotted numeric comparison
  local IFS=. i x y
  local -a have need
  read -r -a have <<<"${1#v}"
  read -r -a need <<<"$2"
  for i in 0 1 2; do
    x="${have[i]:-0}"
    x="${x%%[!0-9]*}"
    y="${need[i]:-0}"
    [ "$((10#${x:-0}))" -gt "$((10#$y))" ] && return 0
    [ "$((10#${x:-0}))" -lt "$((10#$y))" ] && return 1
  done
  return 0
}
port_in_use() { ss -Htln "( sport = :$1 )" 2>/dev/null | grep -q .; }

# Minimums: Docker Engine 25 (health check start_interval, used by every
# service) and Compose 2.24. Memory: the services' limits add up to about
# 4 GB and production measures about 1 GB, so 2 GB works for a small team
# and 4 GB is recommended. Disk: images take about 3 GB and PostgreSQL may
# keep up to 2 GB of WAL plus, while zero-cache is down, up to 8 GB for its
# replication slot (max_slot_wal_keep_size), so 10 GB free is the floor.
preflight() { # preflight [host]: host requirements; failures abort install
  local kernel arch docker_version compose_version tool memory free docker_root
  local relax
  relax=$(opt ignore-requirements)
  kernel=$(uname -s)
  [ "$kernel" = Linux ] && check_ok "Linux" || check_fail "Lictory servers run Linux (found $kernel)."
  arch=$(uname -m)
  case "$arch" in
    x86_64 | amd64 | aarch64 | arm64) check_ok "architecture $arch" ;;
    *) check_fail "Lictory images exist for amd64 and arm64 only (found $arch)." ;;
  esac
  for tool in bash curl jq openssl flock; do
    command -v "$tool" >/dev/null ||
      check_fail "$tool is missing. Install it (Debian/Ubuntu: apt-get install -y curl jq openssl util-linux; RHEL/Fedora: dnf install -y curl jq openssl util-linux)."
  done
  if ! command -v docker >/dev/null; then
    check_fail "Docker Engine is missing: https://docs.docker.com/engine/install/"
  elif ! docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null); then
    check_fail "Cannot reach the Docker daemon: start it (systemctl start docker) and run as root or the deploy user."
  elif version_ge "$docker_version" 25.0; then
    check_ok "Docker Engine $docker_version"
  else
    check_fail "Docker Engine $docker_version is too old: 25.0 or newer is required."
  fi
  if command -v docker >/dev/null; then
    compose_version=$(docker compose version --short 2>/dev/null || true)
    if [ -z "$compose_version" ]; then
      check_fail "The Docker Compose v2 plugin is missing (package docker-compose-plugin)."
    elif version_ge "$compose_version" 2.24; then
      check_ok "Docker Compose ${compose_version#v}"
    else
      check_fail "Docker Compose ${compose_version#v} is too old: 2.24 or newer is required."
    fi
  fi
  if [ -r /proc/meminfo ]; then
    memory=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)
    if [ "$memory" -lt 1800 ]; then
      [ "$relax" = true ] && check_warn "${memory} MB of memory; at least 2 GB is required (4 GB recommended)." ||
        check_fail "${memory} MB of memory; at least 2 GB is required (4 GB recommended). --ignore-requirements overrides."
    elif [ "$memory" -lt 3500 ]; then
      check_warn "${memory} MB of memory: enough for a small team; 4 GB is recommended."
    else
      check_ok "${memory} MB of memory"
    fi
  else
    check_warn "Cannot read /proc/meminfo; make sure the server has at least 2 GB of memory."
  fi
  docker_root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)
  [ -d "$docker_root" ] || docker_root=/
  free=$(df -Pk "$docker_root" 2>/dev/null | awk 'NR == 2 { print int($4 / 1048576) }')
  if [ -z "$free" ]; then
    check_warn "Cannot determine free disk space of $docker_root."
  elif [ "$free" -lt 10 ]; then
    [ "$relax" = true ] && check_warn "${free} GB free on $docker_root; at least 10 GB is required (20 GB recommended)." ||
      check_fail "${free} GB free on $docker_root; at least 10 GB is required (20 GB recommended). --ignore-requirements overrides."
  elif [ "$free" -lt 20 ]; then
    check_warn "${free} GB free on $docker_root; 20 GB is recommended."
  else
    check_ok "${free} GB free on $docker_root"
  fi
}

# DNS is a warning: behind NAT, a proxy or split-horizon DNS the name may
# legitimately resolve elsewhere.
check_dns() { # check_dns <host>
  local host="$1" resolved local_addresses address match=false
  if ! command -v getent >/dev/null; then
    check_warn "Cannot check DNS for $host (getent is missing)."
    return
  fi
  resolved=$(getent ahosts "$host" 2>/dev/null | awk '{ print $1 }' | sort -u || true)
  if [ -z "$resolved" ]; then
    check_warn "$host does not resolve yet: create its A/AAAA record pointing at this server before certificates can be issued."
    return
  fi
  local_addresses=$(hostname -I 2>/dev/null || ip -o addr show 2>/dev/null | awk '{ sub("/.*", "", $4); print $4 }' || true)
  for address in $resolved; do
    word_in "$address" "$(printf '%s' "$local_addresses" | tr '\n' ' ')" && match=true
  done
  if [ "$match" = true ]; then
    check_ok "$host resolves to this server"
  else
    check_warn "$host resolves to $(printf '%s' "$resolved" | tr '\n' ' ')which is not an address of this server (expected behind NAT or a load balancer)."
  fi
}

check_ports() { # check_ports <port...>: free unless this environment holds them
  local port
  if ! command -v ss >/dev/null; then
    check_warn "Cannot check whether ports $* are free (ss is missing)."
    return
  fi
  for port in "$@"; do
    if port_in_use "$port"; then
      check_fail "Port $port is in use by another program. Stop it, or install behind it with --tls proxy (docs/operations/reverse-proxy.md)."
    else
      check_ok "port $port is free"
    fi
  done
}

# -------------------------------------------------------------------- install
interactive=false

# prompt_line <question> <default> [secret]: one styled question on the
# terminal; sets $answer.
prompt_line() {
  local question="$1" default="$2" secret="${3:-}" hint=""
  if [ -n "$secret" ]; then
    [ -z "$default" ] || hint="keep current"
  else
    hint="$default"
  fi
  if [ "$fancy" = true ]; then
    printf ' %s?%s %s%s%s%s %s%s ' "$c_accent" "$c_reset" "$c_bold" "$question" "$c_reset" \
      "${hint:+ $c_dim($hint)$c_reset}" "$c_accent$g_prompt" "$c_reset" >/dev/tty
  else
    printf '%s%s: ' "$question" "${hint:+ [$hint]}" >/dev/tty
  fi
  answer=""
  if [ -n "$secret" ]; then
    IFS= read -r -s answer </dev/tty || true
    if [ "$fancy" = true ] && [ -n "$answer" ]; then printf '%s%s%s\n' "$c_dim" "$g_mask" "$c_reset" >/dev/tty; else printf '\n' >/dev/tty; fi
  else
    IFS= read -r answer </dev/tty || true
  fi
}
prompt_problem() {
  if [ "$fancy" = true ]; then
    printf '   %s%s %s%s\n' "$c_red" "$g_fail" "$1" "$c_reset" >/dev/tty
  else
    printf '  %s\n' "$1" >/dev/tty
  fi
}

# ask <option> <question> <default> [secret]: sets the option unless it was
# given; asks in interactive mode (re-asking until valid), else the default.
ask() {
  local name="$1" question="$2" default="$3" secret="${4:-}" answer reason
  is_given "$name" && return 0
  if [ "$interactive" != true ]; then
    [ -z "$default" ] || set_opt "$name" "$default"
    return 0
  fi
  while :; do
    prompt_line "$question" "$default" "$secret"
    answer="${answer:-$default}"
    if [ -z "$answer" ]; then
      return 0
    fi
    reason=$(invalid_reason "$name" "$answer") || true
    [ -z "$reason" ] && break
    prompt_problem "$reason"
  done
  set_opt "$name" "$answer"
}

# choose <option> <question> <default> <value|description>...: a single
# choice. On a terminal, a menu (arrows or j/k, a number, Enter); without
# styling, a typed answer; without questions, the default.
choose() {
  local name="$1" question="$2" default="$3" values="" item i count selected=0 key rest
  shift 3
  is_given "$name" && return 0
  local -a choices=("$@")
  count=${#choices[@]}
  for i in "${!choices[@]}"; do
    values="$values${values:+, }${choices[i]%%|*}"
    [ "${choices[i]%%|*}" != "$default" ] || selected=$i
  done
  if [ "$interactive" != true ]; then
    [ -z "$default" ] || set_opt "$name" "$default"
    return 0
  fi
  if [ "$fancy" != true ]; then
    ask "$name" "$question ($values)" "$default"
    return 0
  fi
  local width=0
  for item in "${choices[@]}"; do
    item="${item%%|*}"
    [ "${#item}" -le "$width" ] || width=${#item}
  done
  local header=1 room desc
  room=$(($(columns) - width - 10))
  [ "$room" -ge 10 ] || room=10
  if [ "$utf8" = true ]; then
    printf ' %s?%s %s%s%s %s(↑/↓, Enter)%s\n' "$c_accent" "$c_reset" "$c_bold" "$question" "$c_reset" "$c_dim" "$c_reset" >/dev/tty
  else
    printf ' %s?%s %s%s%s %s(up/down or j/k, Enter)%s\n' "$c_accent" "$c_reset" "$c_bold" "$question" "$c_reset" "$c_dim" "$c_reset" >/dev/tty
  fi
  printf '\033[?25l' >/dev/tty
  local first=true
  while :; do
    [ "$first" = true ] || printf '\033[%sA' "$count" >/dev/tty
    first=false
    for i in "${!choices[@]}"; do
      item="${choices[i]}"
      desc="${item#*|}"
      [ "${#desc}" -le "$room" ] || desc="${desc:0:$((room - 1))}$g_ellipsis"
      item="${item%%|*}|$desc"
      if [ "$i" = "$selected" ]; then
        printf '\r\033[K  %s%s %s %-*s%s  %s\n' "$c_accent" "$g_pointer" "$g_on" "$width" "${item%%|*}" "$c_reset" "${item#*|}" >/dev/tty
      else
        printf '\r\033[K    %s%s%s %-*s  %s%s%s\n' "$c_dim" "$g_off" "$c_reset" "$width" "${item%%|*}" "$c_dim" "${item#*|}" "$c_reset" >/dev/tty
      fi
    done
    key=""
    IFS= read -rsn1 key </dev/tty || break
    case "$key" in
      $'\033')
        rest=""
        IFS= read -rsn2 -t 0.05 rest </dev/tty || true
        case "$rest" in
          "[A" | "OA") selected=$(((selected + count - 1) % count)) ;;
          "[B" | "OB") selected=$(((selected + 1) % count)) ;;
        esac
        ;;
      k) selected=$(((selected + count - 1) % count)) ;;
      j | " ") selected=$(((selected + 1) % count)) ;;
      [1-9]) [ "$key" -gt "$count" ] || selected=$((key - 1)) ;;
      "") break ;;
    esac
  done
  printf '\033[?25h' >/dev/tty
  # Collapse the menu into the answered question.
  printf '\033[%sA\r\033[J' $((count + header)) >/dev/tty
  item="${choices[selected]}"
  printf ' %s%s%s %s%s%s %s%s%s %s\n' "$c_green" "$g_ok" "$c_reset" "$c_bold" "$question" "$c_reset" \
    "$c_accent" "$g_prompt" "$c_reset" "${item%%|*}" >/dev/tty
  set_opt "$name" "${item%%|*}"
}

# ask_new_password <question>: asked twice, at least 10 characters without
# spaces (the password policy of packages/core/src/lib/password-policy.ts).
# Sets $new_password.
ask_new_password() {
  local first again answer
  while :; do
    prompt_line "$1" "" secret
    first="$answer"
    if [ "${#first}" -lt 10 ] || [ "${#first}" -gt 64 ]; then
      prompt_problem "Use 10 to 64 characters."
      continue
    fi
    case "$first" in *[[:space:]]*)
      prompt_problem "Passwords can't contain spaces."
      continue
      ;;
    esac
    prompt_line "Repeat the password" "" secret
    again="$answer"
    [ "$first" = "$again" ] && break
    prompt_problem "The passwords don't match; try again."
  done
  new_password="$first"
}
password_problem() { # password_problem <password>: why the server would refuse it
  if [ "${#1}" -lt 10 ] || [ "${#1}" -gt 64 ]; then
    echo "use 10 to 64 characters"
  else
    case "$1" in *[[:space:]]*) echo "passwords can't contain spaces" ;; esac
  fi
}
require_opt() { # require_opt <option> <what>
  [ -n "$(opt "$1")" ] || die "$2 is required (--$1)." 64
}

current() { [ -f "$home/.env" ] && setting "$1" || true; }
current_tls() {
  if [ "$(current PROXY_SCHEME)" = http ]; then
    case "$(current PLATFORM_URL)" in https://*) echo proxy ;; *) echo http ;; esac
  elif [ -n "$(current CADDY_GLOBAL_OPTIONS)" ]; then
    echo internal
  else
    echo acme
  fi
}
current_email() {
  if [ -n "$(current RESEND_API_KEY)" ]; then echo resend
  elif [ -n "$(current SMTP_HOST)" ]; then echo smtp
  else echo none; fi
}
current_storage() {
  if [ -n "$(current R2_ACCOUNT_ID)" ]; then echo r2
  elif [ -n "$(current S3_BUCKET)" ]; then echo s3
  else echo none; fi
}

# Collects the answers into the planned .env assignments ($changes).
changes=""
plan() { changes="$changes$1=$2"$'\n'; }

collect_connection() {
  local tls host port bind url ca
  choose tls "How do browsers reach Lictory securely?" "$(current_tls)" \
    "acme|Automatic HTTPS with Let's Encrypt (public DNS name, ports 80 and 443)" \
    "proxy|Your reverse proxy or ingress terminates TLS in front of this server" \
    "internal|Certificates from your internal CA, or the gateway's own CA" \
    "http|Plain HTTP for evaluation on a trusted machine only"
  tls=$(opt tls)
  local host_default
  host_default=$(current APP_HOST)
  [ -n "$host_default" ] || { [ "$tls" = http ] && host_default=localhost; }
  ask host "Host name users open (DNS name of this server)" "$host_default"
  require_opt host "The host name"
  host=$(opt host)
  [ "$tls" = acme ] && [[ "$host" != *.* ]] && die "Automatic HTTPS needs a public DNS name (got $host); use --tls internal, proxy or http." 64

  local email_default
  email_default=$(current ACME_EMAIL)
  [ "$email_default" != "$unused_email" ] || email_default=""
  case "$tls" in
    acme)
      ask acme-email "Email for certificate expiry notices (Let's Encrypt)" "$email_default"
      require_opt acme-email "An ACME account email"
      plan APP_HOST "$host"
      plan PLATFORM_URL ""
      plan PROXY_SCHEME ""
      plan HTTP_PORT ""
      plan HTTP_BINDING ""
      plan HTTPS_BINDING ""
      plan CADDY_GLOBAL_OPTIONS ""
      plan ACME_EMAIL "$(opt acme-email)"
      ;;
    internal)
      ca=$(current CADDY_GLOBAL_OPTIONS)
      case "$ca" in "acme_ca "*) ca="${ca#acme_ca }" ;; *) ca="" ;; esac
      ask acme-ca "ACME directory of your internal CA (empty: the gateway is its own CA)" "$ca"
      plan APP_HOST "$host"
      plan PLATFORM_URL ""
      plan PROXY_SCHEME ""
      plan HTTP_PORT ""
      plan HTTP_BINDING ""
      plan HTTPS_BINDING ""
      if [ -n "$(opt acme-ca)" ]; then
        ask acme-email "Email for your CA's ACME account" "$email_default"
        require_opt acme-email "An ACME account email"
        plan CADDY_GLOBAL_OPTIONS "acme_ca $(opt acme-ca)"
        plan ACME_EMAIL "$(opt acme-email)"
      else
        plan CADDY_GLOBAL_OPTIONS local_certs
        email_default="${email_default:-$unused_email}"
        plan ACME_EMAIL "$(opt acme-email | grep . || printf '%s' "$email_default")"
      fi
      ;;
    proxy | http)
      port=$(current HTTP_PORT)
      ask http-port "Port the gateway serves plain HTTP on" "${port:-8080}"
      port=$(opt http-port)
      bind=$(current HTTP_BINDING)
      bind="${bind%%:*}"
      word_in "$bind" "127.0.0.1 0.0.0.0" || bind=127.0.0.1
      choose bind "Which interfaces does the gateway listen on?" "$bind" \
        "127.0.0.1|This host only (a proxy on the same server)" \
        "0.0.0.0|All interfaces (a proxy on another machine)"
      bind=$(opt bind)
      if [ "$tls" = proxy ]; then
        url=$(current PLATFORM_URL)
        case "$url" in https://*) ;; *) url="https://$host" ;; esac
        ask public-url "Public address your proxy serves" "$url"
        ask trusted-proxies "Address(es) your proxy connects from, space-separated (empty: decide later with lictory doctor)" "$(current CADDY_TRUSTED_PROXIES)"
        plan PLATFORM_URL "$(opt public-url)"
        plan CADDY_TRUSTED_PROXIES "$(opt trusted-proxies)"
      else
        url="http://$host"
        [ "$port" = 80 ] || url="$url:$port"
        plan PLATFORM_URL "$url"
      fi
      plan APP_HOST "$host"
      plan PROXY_SCHEME http
      plan HTTP_PORT "$port"
      plan HTTP_BINDING "$bind:$port:80"
      # 443 stays off the public interface; Docker picks a free local port.
      plan HTTPS_BINDING "127.0.0.1::443"
      plan CADDY_GLOBAL_OPTIONS ""
      plan ACME_EMAIL "${email_default:-$unused_email}"
      ;;
  esac
  is_given trusted-proxies && [ "$tls" != proxy ] && plan CADDY_TRUSTED_PROXIES "$(opt trusted-proxies)"
  case "$tls" in
    acme | internal) planned_url="https://$host" ;;
    proxy) planned_url=$(opt public-url) ;;
    http) planned_url="$url" ;;
  esac
  return 0
}

# Where PostgreSQL runs: the bundled container, or a server or managed service
# that meets Lictory's requirements (docs/operations/external-database.md).
collect_database() {
  local database current_database ca compose_version
  current_database=$(current LICTORY_DATABASE)
  current_database="${current_database:-bundled}"
  choose database "Where does PostgreSQL run?" "$current_database" \
    "bundled|A PostgreSQL container on this server, backed up by Lictory (recommended)" \
    "external|Your own PostgreSQL server or a managed service (RDS, Cloud SQL, Azure, Neon, Supabase…)"
  database=$(opt database)
  # Moving data between databases is a dump and restore, never a setting.
  if [ -n "$(current_version)" ] && [ "$database" != "$current_database" ]; then
    die "$environment already stores its data in the $current_database database. Moving it to the $database one is a migration of the data: see docs/operations/external-database.md#moving-an-installation." 64
  fi
  plan LICTORY_DATABASE "$([ "$database" = external ] && echo external)"
  [ "$database" = external ] || return 0
  compose_version=$(docker compose version --short 2>/dev/null || true)
  [ -z "$compose_version" ] || version_ge "$compose_version" 2.24.4 ||
    die "An external database needs Docker Compose 2.24.4 or newer (found ${compose_version#v})." 64
  note "Lictory checks the database's requirements before it migrates: docs/operations/external-database.md"
  ask database-host "Database host: the direct endpoint, never a pooler" "$(current DATABASE_HOST)"
  require_opt database-host "The database host"
  ask database-port "Database port" "$(current DATABASE_PORT | grep . || echo 5432)"
  choose database-sslmode "How is the database's certificate checked?" "$(current DATABASE_SSLMODE | grep . || echo verify-full)" \
    "verify-full|Encrypted, certificate and host name verified (recommended)" \
    "require|Encrypted, certificate not verified"
  ca=$(current DATABASE_CA_FILE)
  [ "$ca" != "$home/database-ca.pem" ] || ca=""
  ask database-ca-file "CA bundle (PEM) for the database's certificate (empty: the system CAs)" "$ca"
  ca=$(opt database-ca-file)
  if [ -n "$ca" ] && [ "$ca" != "$home/database-ca.pem" ]; then
    [ -r "$ca" ] || die "Cannot read the CA bundle $ca." 64
    grep -q 'BEGIN CERTIFICATE' "$ca" || die "$ca is not a PEM certificate bundle." 64
  fi
  plan DATABASE_HOST "$(opt database-host)"
  plan DATABASE_PORT "$(opt database-port)"
  plan DATABASE_SSLMODE "$(opt database-sslmode)"
  plan DATABASE_CA_FILE "$([ -n "$ca" ] && echo "$home/database-ca.pem")"
  if [ "$interactive" = true ] && ! is_given database-admin-url; then
    note "Lictory needs four roles and two databases on that server (lictory_owner, lictory_app, zero, lictory_ops)."
    ask database-admin-url "Administrator connection URL to create them now (empty: they exist, or later with lictory database setup)" "" secret
  fi
  # Lictory takes no backups of a database it does not run.
  plan BACKUP_TARGET none
}

collect_services() {
  local host port url email storage backup recipient
  host=$(opt host)

  choose email "How does Lictory send email (invitations, verification, password reset)?" "$(current_email)" \
    "smtp|Your SMTP server (STARTTLS on 587, or 25)" \
    "resend|The Resend API" \
    "none|No email: invitations and password reset links are not delivered"
  email=$(opt email)
  local from_default="Lictory <no-reply@$host>"
  case "$email" in
    smtp)
      ask smtp-host "SMTP server host" "$(current SMTP_HOST)"
      require_opt smtp-host "The SMTP host"
      port=$(current SMTP_PORT)
      ask smtp-port "SMTP port (587 STARTTLS, 465 TLS or 25)" "${port:-587}"
      ask smtp-user "SMTP user (empty: no authentication)" "$(current SMTP_USER)"
      [ -z "$(opt smtp-user)" ] || ask smtp-password "SMTP password" "$(current SMTP_PASSWORD)" secret
      url=$(current SMTP_FROM)
      ask smtp-from "Sender address" "${url:-$from_default}"
      plan SMTP_HOST "$(opt smtp-host)"
      plan SMTP_PORT "$(opt smtp-port)"
      plan SMTP_USER "$(opt smtp-user)"
      plan SMTP_PASSWORD "$(opt smtp-password)"
      plan SMTP_FROM "$(opt smtp-from)"
      plan RESEND_API_KEY ""
      ;;
    resend)
      ask resend-api-key "Resend API key" "$(current RESEND_API_KEY)" secret
      require_opt resend-api-key "The Resend API key"
      url=$(current RESEND_FROM_EMAIL)
      ask email-from "Sender address (a domain verified in Resend)" "${url:-$from_default}"
      plan RESEND_API_KEY "$(opt resend-api-key)"
      plan RESEND_FROM_EMAIL "$(opt email-from)"
      ;;
    none)
      plan RESEND_API_KEY ""
      plan SMTP_HOST ""
      ;;
  esac

  storage=$(current_storage)
  if [ "$storage" != r2 ] || is_given storage; then
    choose storage "Where are attachments stored?" "${storage/r2/s3}" \
      "s3|Any S3-compatible bucket reachable from browsers" \
      "none|Nowhere: attachments are disabled"
    if [ "$(opt storage)" = s3 ]; then
      ask s3-endpoint "S3 endpoint reachable from browsers (empty: AWS S3)" "$(current S3_ENDPOINT)"
      ask s3-region "Region (empty: us-east-1 with an endpoint)" "$(current S3_REGION)"
      [ -n "$(opt s3-endpoint)" ] || require_opt s3-region "The AWS region"
      ask s3-bucket "Bucket" "$(current S3_BUCKET)"
      require_opt s3-bucket "The bucket"
      ask s3-access-key-id "Access key ID" "$(current S3_ACCESS_KEY_ID)"
      require_opt s3-access-key-id "The access key ID"
      ask s3-secret-access-key "Secret access key" "$(current S3_SECRET_ACCESS_KEY)" secret
      require_opt s3-secret-access-key "The secret access key"
      for key in S3_ENDPOINT S3_REGION S3_BUCKET S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY S3_FORCE_PATH_STYLE; do
        plan "$key" "$(opt "$(printf '%s' "$key" | tr '[:upper:]_' '[:lower:]-')")"
      done
    else
      for key in S3_ENDPOINT S3_REGION S3_BUCKET S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY S3_FORCE_PATH_STYLE; do plan "$key" ""; done
    fi
    for key in R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_BUCKET_NAME R2_S3_ENDPOINT; do plan "$key" ""; done
  fi

  choose oidc "Sign in with your company identity provider (OpenID Connect)?" "$([ -n "$(current OIDC_ISSUER)" ] && echo yes || echo no)" \
    "yes|Okta, Entra ID, Keycloak, Authentik, Google Workspace…" \
    "no|Passwords (and passkeys) only; you can add SSO later"
  if [ "$(opt oidc)" = yes ] || is_given oidc-issuer; then
    ask oidc-issuer "Issuer URL" "$(current OIDC_ISSUER)"
    require_opt oidc-issuer "The OIDC issuer"
    ask oidc-client-id "Client ID" "$(current OIDC_CLIENT_ID)"
    require_opt oidc-client-id "The OIDC client ID"
    ask oidc-client-secret "Client secret" "$(current OIDC_CLIENT_SECRET)" secret
    require_opt oidc-client-secret "The OIDC client secret"
    url=$(current OIDC_DISPLAY_NAME)
    ask oidc-display-name "Button label" "${url:-SSO}"
    plan OIDC_ISSUER "$(opt oidc-issuer)"
    plan OIDC_CLIENT_ID "$(opt oidc-client-id)"
    plan OIDC_CLIENT_SECRET "$(opt oidc-client-secret)"
    plan OIDC_DISPLAY_NAME "$(opt oidc-display-name)"
  elif [ "$(opt oidc)" = no ]; then
    plan OIDC_ISSUER ""
    plan OIDC_CLIENT_ID ""
    plan OIDC_CLIENT_SECRET ""
  fi

  if [ "$(opt database)" = external ]; then
    note "Backups: the database is external; its provider's backups and point-in-time recovery protect it."
    return 0
  fi
  backup=$(current BACKUP_TARGET)
  choose backup "Where do backups go?" "${backup:-local}" \
    "local|A directory on this server or a mounted disk (NAS, second disk)" \
    "s3|An S3-compatible bucket (never the attachment bucket)" \
    "rclone|Any rclone remote (SFTP, Azure, Google Cloud Storage…)" \
    "none|No backups (evaluation only)"
  backup=$(opt backup)
  plan BACKUP_TARGET "$backup"
  case "$backup" in
    local)
      ask backup-path "Backup directory on this host (empty: a Docker volume on this server, not a disaster-recovery copy)" "$(current BACKUP_LOCAL_PATH)"
      plan BACKUP_LOCAL_PATH "$(opt backup-path)"
      ;;
    s3)
      ask backup-bucket "Backup bucket (never the attachment bucket)" "$(current BACKUP_BUCKET)"
      require_opt backup-bucket "The backup bucket"
      ask backup-s3-endpoint "Backup S3 endpoint (empty: AWS S3)" "$(current BACKUP_S3_ENDPOINT)"
      url=$(current BACKUP_S3_PROVIDER)
      [ -n "$url" ] || { [ -n "$(opt backup-s3-endpoint)" ] && url=Other || url=AWS; }
      ask backup-s3-provider "rclone S3 provider (AWS, Cloudflare, Minio, Other…)" "$url"
      url=$(current BACKUP_S3_REGION)
      ask backup-s3-region "Backup bucket region" "${url:-auto}"
      ask backup-s3-access-key-id "Backup access key ID" "$(current BACKUP_S3_ACCESS_KEY_ID)"
      require_opt backup-s3-access-key-id "The backup access key ID"
      ask backup-s3-secret-access-key "Backup secret access key" "$(current BACKUP_S3_SECRET_ACCESS_KEY)" secret
      require_opt backup-s3-secret-access-key "The backup secret access key"
      for key in BACKUP_BUCKET BACKUP_S3_PROVIDER BACKUP_S3_ENDPOINT BACKUP_S3_REGION BACKUP_S3_ACCESS_KEY_ID BACKUP_S3_SECRET_ACCESS_KEY; do
        plan "$key" "$(opt "$(printf '%s' "$key" | tr '[:upper:]_' '[:lower:]-')")"
      done
      ;;
    rclone)
      ask backup-rclone-remote "rclone remote (for example :sftp,host=nas,user=lictory:backups)" "$(current BACKUP_RCLONE_REMOTE)"
      require_opt backup-rclone-remote "The rclone remote"
      plan BACKUP_RCLONE_REMOTE "$(opt backup-rclone-remote)"
      ;;
  esac
  if [ "$backup" != none ]; then
    recipient=$(current BACKUP_AGE_RECIPIENTS)
    [[ "$recipient" =~ $age_pattern ]] || [ "$recipient" = none ] || recipient=generate
    ask backup-age-recipient "Backup encryption: an age public key (age1…), generate, or none" "$recipient"
    # A generated key is planned once it exists (cmd_install).
    [ "$(opt backup-age-recipient)" = generate ] || plan BACKUP_AGE_RECIPIENTS "$(opt backup-age-recipient)"
  fi
}

# Who may create accounts and organizations (LICTORY_SIGNUP_MODE,
# LICTORY_ALLOWED_EMAIL_DOMAINS, LICTORY_ORGANIZATION_CREATION). Instance
# administrators always can, from the admin console or `lictory admin`.
collect_access() {
  local mode domains creation
  mode=$(current LICTORY_SIGNUP_MODE)
  word_in "$mode" "invite closed open" || mode=invite
  choose signup-mode "Who can create a Lictory account?" "$mode" \
    "invite|People invited by an administrator (recommended)" \
    "closed|Nobody on their own: administrators create every account" \
    "open|Anyone who can reach this server"
  mode=$(opt signup-mode)
  if [ "$mode" = open ] && [ "$(opt tls)" != http ]; then
    warn "Open sign-up lets anyone who can reach ${planned_url:-this server} create an account. Keep it on a private network."
  fi
  domains=$(current LICTORY_ALLOWED_EMAIL_DOMAINS)
  ask allowed-email-domains "Allowed email domains for new accounts, comma-separated (empty: any)" "$domains"
  domains=$(opt allowed-email-domains)
  # One canonical spelling: lowercase, comma-separated.
  domains=$(printf '%s' "$domains" | tr '[:upper:]' '[:lower:]' | tr -s ', ' '\n\n' | grep . | paste -sd, - || true)
  creation=$(current LICTORY_ORGANIZATION_CREATION)
  word_in "$creation" "administrators everyone" || creation=administrators
  choose organization-creation "Who can create organizations?" "$creation" \
    "administrators|Instance administrators only (recommended)" \
    "everyone|Any signed-in person"
  plan LICTORY_SIGNUP_MODE "$mode"
  plan LICTORY_ALLOWED_EMAIL_DOMAINS "$domains"
  plan LICTORY_ORGANIZATION_CREATION "$(opt organization-creation)"
}

signup_words() { # signup_words <mode>: the sign-up mode in plain words
  case "$1" in
    closed) printf 'only instance administrators create accounts' ;;
    open) printf 'anyone who can reach %s can create an account' "$(platform_url)" ;;
    *) printf 'people join when an administrator invites them' ;;
  esac
}
organization_words() {
  case "$1" in
    everyone) printf 'any signed-in person can create organizations' ;;
    *) printf 'only instance administrators create organizations' ;;
  esac
}


# Prints the planned assignments that differ from the current .env.
pending_changes() {
  local key value
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="${line%%=*}"
    value="${line#*=}"
    [ "$(setting "$key")" = "$value" ] || printf '%s\n' "$key"
  done <<<"$changes"
}

apply_changes() {
  local key value
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    key="${line%%=*}"
    value="${line#*=}"
    [ "$(setting "$key")" = "$value" ] || set_env "$home/.env" "$key" "$value"
  done <<<"$changes"
}

# An age key pair made with the release's ops image (age-keygen); only the
# public key goes into .env, the identity is written for the operator to
# move offline.
generate_age_key() { # generate_age_key <ops image> <identity file>
  local image="$1" file="$2" key
  [ ! -e "$file" ] || die "$file already exists; move it away or pass --backup-age-recipient."
  (umask 077 && docker run --rm --network none --entrypoint age-keygen "$image" >"$file" 2>/dev/null) ||
    die "Could not generate a backup key pair."
  key=$(sed -n 's/^# public key: //p' "$file")
  [[ "$key" =~ $age_pattern ]] || die "age-keygen returned no public key."
  printf '%s' "$key"
}

# masked <value>: secrets shown as dots in the review.
masked() { [ -z "$1" ] && printf 'none' || printf '%s' "$g_mask"; }

# The review before anything changes: the answers in words, and for an
# existing environment the .env keys that change.
review() {
  local tls email storage backup lines=() changed="$1"
  tls=$(opt tls)
  case "$tls" in
    acme) lines+=("$(row "Address" "${planned_url} (automatic HTTPS)")") ;;
    internal) lines+=("$(row "Address" "${planned_url} ($([ -n "$(opt acme-ca)" ] && echo "certificates from $(opt acme-ca)" || echo "the gateway's own CA"))")") ;;
    proxy) lines+=("$(row "Address" "${planned_url} (behind your proxy, gateway on $(opt bind):$(opt http-port))")") ;;
    http) lines+=("$(row "Address" "${planned_url} (plain HTTP, evaluation only)")") ;;
  esac
  if [ "$(opt database)" = external ]; then
    lines+=("$(row "Database" "external: $(opt database-host):$(opt database-port), sslmode $(opt database-sslmode)$([ -z "$(opt database-ca-file)" ] || printf ', CA %s' "$(opt database-ca-file)")$(is_given database-admin-url && [ -n "$(opt database-admin-url)" ] && printf ', roles created with the administrator URL')")")
  else
    lines+=("$(row "Database" "bundled PostgreSQL container on this server")")
  fi
  email=$(opt email)
  case "$email" in
    smtp) lines+=("$(row "Email" "SMTP $(opt smtp-host):$(opt smtp-port)$([ -n "$(opt smtp-user)" ] && printf ' as %s, password %s' "$(opt smtp-user)" "$(masked "$(opt smtp-password)")") from $(opt smtp-from)")") ;;
    resend) lines+=("$(row "Email" "Resend (key $(masked "$(opt resend-api-key)")) from $(opt email-from)")") ;;
    *) lines+=("$(row "Email" "none: invitations and password reset are not delivered")") ;;
  esac
  storage=$(opt storage)
  if [ "$storage" = s3 ]; then
    lines+=("$(row "Attachments" "bucket $(opt s3-bucket)$([ -z "$(opt s3-endpoint)" ] || printf ' at %s' "$(opt s3-endpoint)"), secret $(masked "$(opt s3-secret-access-key)")")")
  elif [ -n "$storage" ]; then
    lines+=("$(row "Attachments" "disabled")")
  else
    lines+=("$(row "Attachments" "unchanged (Cloudflare R2)")")
  fi
  if [ "$(opt oidc)" = yes ]; then
    lines+=("$(row "Single sign-on" "$(opt oidc-display-name) via $(opt oidc-issuer), secret $(masked "$(opt oidc-client-secret)")")")
  else
    lines+=("$(row "Single sign-on" "off")")
  fi
  backup=$(opt backup)
  [ "$(opt database)" != external ] || backup=external
  case "$backup" in
    external) lines+=("$(row "Backups" "your database provider's (Lictory takes none)")") ;;
    local) lines+=("$(row "Backups" "$( [ -n "$(opt backup-path)" ] && opt backup-path || printf 'a volume on this server')")") ;;
    s3) lines+=("$(row "Backups" "bucket $(opt backup-bucket), secret $(masked "$(opt backup-s3-secret-access-key)")")") ;;
    rclone) lines+=("$(row "Backups" "rclone $(opt backup-rclone-remote)")") ;;
    none) lines+=("$(row "Backups" "none")") ;;
  esac
  if [ "$backup" != none ] && [ "$backup" != external ]; then
    case "$(opt backup-age-recipient)" in
      generate) lines+=("$(row "Backup encryption" "a new age key pair")") ;;
      none) lines+=("$(row "Backup encryption" "none (backups are not encrypted)")") ;;
      *) lines+=("$(row "Backup encryption" "age $(opt backup-age-recipient | cut -c1-16)$g_ellipsis")") ;;
    esac
  fi
  lines+=("$(row "Accounts" "$(signup_words_planned "$(opt signup-mode)")")")
  lines+=("$(row "Allowed email domains" "$(planned LICTORY_ALLOWED_EMAIL_DOMAINS | grep . || echo any)")")
  lines+=("$(row "Organizations" "$(organization_words "$(opt organization-creation)")")")
  lines+=("$(row "Release channel" "$(planned LICTORY_RELEASE_CHANNEL)")")
  box "${lines[@]}"
  if [ "$existed" = true ]; then
    if [ -n "$changed" ]; then
      say "Changes to $home/.env: $(printf '%s' "$changed" | tr '\n' ' ')"
    else
      note "No changes to $home/.env."
    fi
  fi
}
signup_words_planned() {
  case "$1" in
    open) printf 'anyone who can reach %s can create one' "${planned_url:-this server}" ;;
    *) signup_words "$1" ;;
  esac
}
planned() { # planned <key>: the last planned value
  printf '%s' "$changes" | grep -E "^$1=" | tail -n 1 | cut -d= -f2- || true
}

cmd_install() {
  parse "$install_values" "ignore-requirements" "$@"
  [ ${#positional[@]} -eq 0 ] || usage_error "install takes no arguments."
  require_root
  select_environment install
  [ "$(opt yes)" != true ] && [ -t 0 ] && interactive=true
  local user active release_file bundle tmp changed identity=""
  existed=false
  user=$(deploy_user)
  [ -f "$home/.env" ] && existed=true
  active=$(current_version)
  steps_total=9
  banner "self-hosted installer"

  step "Checking this server"
  preflight
  [ "$failures" -eq 0 ] || die "Fix the failed checks above, then run lictory install again."

  step "Address and certificates"
  [ "$existed" = true ] && note "Existing $home/.env: its secrets are kept; Enter keeps each current value."
  collect_connection
  if [ "$(opt tls)" = acme ] || [ "$(opt tls)" = internal ]; then
    check_dns "$(opt host)"
    [ -n "$active" ] || check_ports 80 443
  elif [ -z "$active" ]; then
    check_ports "$(opt http-port)"
  fi
  [ "$failures" -eq 0 ] || die "Fix the failed checks above, then run lictory install again."

  step "Database"
  collect_database

  step "Email, attachments, sign-in and backups"
  collect_services

  step "Access policy"
  note "Instance administrators always create accounts and organizations, in the admin console (/admin) or with lictory admin."
  collect_access
  local channel
  channel=$(opt channel)
  if [ -z "$channel" ]; then
    channel=$(current LICTORY_RELEASE_CHANNEL)
    [ -n "$channel" ] || channel=$(env_value "$root/share/bundle/release.env" LICTORY_CHANNEL)
    channel="${channel:-stable}"
  fi
  plan LICTORY_RELEASE_CHANNEL "$channel"
  local registry
  registry=$(current LICTORY_IMAGE_REGISTRY)
  case "$registry" in "" | *replace-with-owner*) plan LICTORY_IMAGE_REGISTRY "$default_registry" ;; esac

  step "Review"
  changed=""
  [ "$existed" = false ] || changed=$(pending_changes | awk '!seen[$0]++')
  review "$changed"
  if [ "$existed" = true ] && [ -n "$changed" ]; then
    confirm "Apply these changes?" || die "Nothing changed."
  elif [ "$existed" = false ] && [ "$interactive" = true ]; then
    confirm "Install Lictory with these settings?" || die "Nothing was installed."
  fi

  step "Installing"
  bundle=$(bundle_dir)
  run_task "Host tooling" env LICTORY_ROOT="$root" DEPLOY_USER="$user" LICTORY_ENVIRONMENTS="$environment" \
    LICTORY_CLI_PATH="$cli_path" SHOW_NEXT_STEPS=false bash "$bundle/provision/install.sh" ||
    die "The host tooling could not be installed; see the messages above."

  if [ "$existed" = false ]; then
    tmp=$(as_deploy env LICTORY_ENV_TEMPLATE="$bundle/env/self-hosted.env.example" \
      LICTORY_IMAGE_REGISTRY="$default_registry" LICTORY_RELEASE_CHANNEL="$channel" \
      bash "$bundle/provision/new-environment.sh" "$environment" 2>&1) ||
      die "Could not create $home/.env: $tmp"
    check_ok "Created $home/.env with generated secrets (mode 0600). Keep a copy in your password manager."
  fi

  # The release to install: a chosen version, the one get.sh verified, or
  # the newest of the channel. An active environment keeps its release.
  release_file=""
  if [ -z "$active" ]; then
    if [ -z "$(opt version)" ] && [ -f "$root/share/bundle/release.env" ] &&
      [ "$(env_value "$root/share/bundle/release.env" LICTORY_CHANNEL)" = "$channel" ]; then
      release_file="$root/share/bundle/release.env"
      say "Lictory $(env_value "$release_file" LICTORY_VERSION) ($channel), verified by get.sh."
    else
      resolve_release "$channel" "$(opt version)"
      release_file=$(mktemp)
      fetch_release "$release_file"
      say "Lictory $release_version ($channel): $release_notes"
    fi
    run_task "Pulling the release images" pull_release_images "$release_file" ||
      die "The release images could not be pulled; see the messages above."
  elif [ -n "$(opt version)" ] && [ "$(opt version)" != "$active" ]; then
    say "$environment already runs $active; use: lictory upgrade $(opt version)"
  fi

  if [ "$(opt database)" != external ] && [ "$(opt backup)" != none ] && [ "$(opt backup-age-recipient)" = generate ]; then
    identity=$(opt backup-identity-file)
    identity="${identity:-/root/lictory-$environment-backup-identity.txt}"
    local ops_image key
    ops_image=$(env_value "${release_file:-$home/current/release.env}" OPS_IMAGE)
    key=$(generate_age_key "$ops_image" "$identity")
    set_opt backup-age-recipient "$key"
    plan BACKUP_AGE_RECIPIENTS "$key"
  fi
  local path
  path=$(opt backup-path)
  if [ "$(opt backup)" = local ] && [ -n "$path" ]; then
    # The ops image's postgres user (uid 70) writes backups there.
    install -d -m 0700 -o 70 -g 70 "$path" 2>/dev/null || warn "Make $path a directory owned by uid 70 with mode 0700."
  fi

  # The database's CA bundle lives with the environment, readable by the
  # containers (a certificate is public).
  local ca
  ca=$(opt database-ca-file)
  if [ "$(opt database)" = external ] && [ -n "$ca" ] && [ "$ca" != "$home/database-ca.pem" ]; then
    install -m 0644 "$ca" "$home/database-ca.pem"
    is_root && chown "$user" "$home/database-ca.pem" 2>/dev/null || true
  fi
  # The administrator URL is used once, by deploy.sh, and never stored.
  if [ "$(opt database)" = external ] && [ -n "$(opt database-admin-url)" ]; then
    export DATABASE_ADMIN_URL
    DATABASE_ADMIN_URL=$(opt database-admin-url)
  fi
  # The review computed the changes of an existing environment; a new one
  # (or a key generated since) is compared with its .env now.
  [ "$existed" = true ] && [ -z "$identity" ] || changed=$(pending_changes | awk '!seen[$0]++')
  if [ -n "$changed" ]; then
    [ "$existed" = false ] || cp -p "$home/.env" "$home/.env.backup-$(date -u +%Y%m%dT%H%M%SZ)"
    apply_changes
  fi

  if [ -n "$release_file" ]; then
    run_task "Deploying Lictory $(env_value "$release_file" LICTORY_VERSION)" deploy_sh release <"$release_file" ||
      die "The release did not activate; see the messages above and run: lictory doctor$([ "$(opt database)" != external ] || printf '\nFor the database: sudo lictory database check (requirements) or sudo lictory database setup (roles), then run lictory install again.')"
  elif [ -n "$changed" ]; then
    run_task "Applying the new settings to $active" deploy_sh activate "$active" ||
      die "Re-activation failed; the previous settings are in $home/.env.backup-*. Run: lictory doctor"
  else
    say "Nothing changed; $environment runs $active. New releases: lictory upgrade"
  fi
  refresh_share
  start_timers

  step "Checking $(platform_url)"
  # Behind a proxy that may not be configured yet, do not wait long.
  if run_task "Waiting for $(platform_url)/readyz" wait_until_ready "$([ "$(current_tls)" = proxy ] && echo 20 || echo 180)"; then
    say "Lictory is up: $(platform_url)"
  else
    warn "$(platform_url)/readyz is not reachable from this server yet. The services are running; check DNS, firewall and certificates with: lictory doctor"
  fi

  step "First administrator"
  first_administrator install
  summary "$identity"
}

# ------------------------------------------------------- instance administration
# admin_call <command> [args...]: admin.js inside the api container, as JSON.
# Sets admin_out (stdout), admin_err (stderr tail) and admin_status. The
# caller supplies stdin (a password with --password-stdin), else /dev/null.
admin_out=""
admin_err=""
admin_status=0
admin_call() {
  local err
  err=$(mktemp)
  admin_status=0
  admin_out=$(compose exec -T api node apps/api/dist/admin.js "$@" --json 2>"$err") || admin_status=$?
  admin_err=$(tail -n 5 "$err" 2>/dev/null || true)
  rm -f "$err"
  return "$admin_status"
}
admin_value() { printf '%s' "$admin_out" | jq -r "$1" 2>/dev/null || true; }
admin_message() {
  local message
  message=$(admin_value '.error.message // empty')
  [ -n "$message" ] || message=$(printf '%s' "$admin_err" | tail -n 1)
  printf '%s' "${message:-the administration command failed (exit $admin_status)}"
}
# admin_status_json: the instance status, or false when the api service
# cannot answer (not running yet, or an older release without admin.js).
admin_status_json() {
  admin_call status </dev/null >/dev/null 2>&1 || return 1
  [ -n "$(admin_value '.administrators // empty')" ]
}

# first_administrator <install|setup>: creates the first instance
# administrator and the organization they own. From install, problems are
# warnings with the command to finish later; from `admin setup`, errors.
admin_email_created=""
admin_pending=false
first_administrator() {
  local from="$1" count password_login sso organization handle name email password=""
  fail() {
    if [ "$from" = install ]; then
      warn "$1"
      note "Finish later with: sudo lictory admin setup"
      admin_pending=true
      return 1
    fi
    die "$1"
  }
  if ! admin_status_json; then
    fail "The api service did not answer, so the first administrator was not created ($(admin_message))." || return 0
  fi
  count=$(admin_value '.administrators')
  if [ "$count" -gt 0 ] 2>/dev/null; then
    [ "$from" = install ] || die "Lictory already has an instance administrator (lictory admin list). Add more with: lictory admin grant <email>" 3
    check_ok "$count instance administrator(s) already exist. More: sudo lictory admin grant <email>"
    return 0
  fi
  password_login=$(admin_value '.passwordLogin')
  sso=$(admin_value '.sso // empty')
  if [ "$interactive" != true ] && [ -z "$(opt admin-email)" ]; then
    if [ "$from" = install ]; then
      admin_pending=true
      note "No administrator yet. Create one with: sudo lictory admin setup"
      return 0
    fi
    die "Pass --admin-email, --admin-name and --organization (password: LICTORY_ADMIN_PASSWORD), or run without --yes on a terminal." 64
  fi
  if [ "$from" = install ] && [ "$interactive" = true ] && [ -z "$(opt admin-email)" ]; then
    if ! confirm "Create the first administrator now?"; then
      admin_pending=true
      return 0
    fi
  fi
  note "The first administrator manages Lictory: accounts, organizations and other administrators."
  note "They also own the first organization (your company or team)."
  ask organization "Organization name (your company or team)" ""
  organization=$(opt organization)
  while [ -z "$organization" ]; do
    [ "$interactive" = true ] || fail "--organization is required." || return 0
    prompt_problem "Enter a name."
    ask organization "Organization name (your company or team)" ""
    organization=$(opt organization)
  done
  handle=$(suggest_handle "$organization")
  [ -z "$(handle_problem "$handle")" ] || handle=""
  ask organization-handle "Organization handle (its address: $(platform_url)/<handle>)" "$handle"
  handle=$(opt organization-handle)
  ask admin-name "Your full name" ""
  name=$(opt admin-name)
  while [ -z "$name" ]; do
    [ "$interactive" = true ] || fail "--admin-name is required." || return 0
    prompt_problem "Enter a name."
    ask admin-name "Your full name" ""
    name=$(opt admin-name)
  done
  ask admin-email "Your work email (you sign in with it)" ""
  email=$(opt admin-email)
  while [ -z "$email" ]; do
    prompt_problem "Enter an email address."
    ask admin-email "Your work email (you sign in with it)" ""
    email=$(opt admin-email)
  done
  local args=(setup --organization "$organization" --name "$name" --email "$email")
  [ -z "$handle" ] || args+=(--organization-handle "$handle")
  if [ "$password_login" != false ]; then
    if [ "$interactive" = true ] && [ -z "${LICTORY_ADMIN_PASSWORD:-}" ]; then
      ask_new_password "Choose a password"
      password="$new_password"
    else
      password="${LICTORY_ADMIN_PASSWORD:-}"
      [ -n "$password" ] || fail "Set the administrator's password in LICTORY_ADMIN_PASSWORD (never as a flag)." || return 0
      local problem
      problem=$(password_problem "$password")
      [ -z "$problem" ] || fail "LICTORY_ADMIN_PASSWORD: $problem." || return 0
    fi
    args+=(--password-stdin)
  else
    note "Password sign-in is off: $name signs in with ${sso:-your identity provider} as $email."
  fi
  note "Creating $email and $organization$g_ellipsis"
  if [ -n "$password" ]; then
    admin_call "${args[@]}" <<<"$password" || true
  else
    admin_call "${args[@]}" </dev/null || true
  fi
  password=""
  new_password=""
  case "$admin_status" in
    0)
      admin_email_created="$email"
      check_ok "$email is the instance administrator and owns $(admin_value '.organization.name') ($(admin_value '.url'))."
      ;;
    3) check_ok "Lictory already has an instance administrator: lictory admin list" ;;
    *) fail "The first administrator was not created: $(admin_message)" || return 0 ;;
  esac
}
summary() {
  local identity="$1" url mode lines=() notes=()
  url=$(platform_url)
  mode=$(setting LICTORY_SIGNUP_MODE)
  mode="${mode:-invite}"
  if [ "$fancy" = true ]; then
    lines+=("${c_green}${g_ok}${c_reset} ${c_bold}Lictory is ready${c_reset}")
    lines+=("")
    lines+=("$(row "Open" "$url")")
    [ -z "$admin_email_created" ] || lines+=("$(row "Administrator" "$admin_email_created")")
    lines+=("$(row "Admin console" "$url/admin")")
    lines+=("$(row "Accounts" "$(signup_words "$mode")")")
    lines+=("$(row "Organizations" "$(organization_words "$(setting LICTORY_ORGANIZATION_CREATION)")")")
    [ -z "$(current_version)" ] || lines+=("$(row "Release" "$(current_version) ($(channel_of_environment))")")
    box "${lines[@]}"
  fi
  step "Next steps"
  steps_total=0
  if [ -n "$admin_email_created" ]; then
    say "1. Sign in at $url as $admin_email_created."
  elif [ "$admin_pending" = true ]; then
    say "1. Create the first administrator and organization: sudo lictory admin setup"
  else
    say "1. Sign in at $url with an instance administrator account (lictory admin list)."
  fi
  say "2. Open the admin console at $url/admin to invite people, create accounts and organizations,"
  say "   and choose who administers Lictory."
  say "   Accounts: $(signup_words "$mode"); $(organization_words "$(setting LICTORY_ORGANIZATION_CREATION)")."
  say "   Change it with: sudo lictory install --signup-mode invite|closed|open --organization-creation administrators|everyone"
  if [ "$(current_email)" = none ]; then
    notes+=("No outbound email: invitations, verification and password reset email are not delivered.")
    notes+=("   Configure SMTP or Resend (sudo lictory install --email smtp), or create accounts with passwords: sudo lictory admin create-user")
  fi
  if [ -n "$identity" ]; then
    notes+=("Backup identity (private key): $identity")
    notes+=("   Move it to your password manager or an offline copy, then delete it from this server.")
    notes+=("   Restores and restore drills need it.")
  fi
  [ "$(setting BACKUP_TARGET)" = local ] && [ -z "$(setting BACKUP_LOCAL_PATH)" ] &&
    notes+=("Backups stay on this server's disk: set --backup-path (a NAS or second disk), s3 or rclone for disaster recovery.")
  if [ "$(current_tls)" = proxy ] && [ -z "$(setting CADDY_TRUSTED_PROXIES)" ]; then
    notes+=("Set the address your reverse proxy connects from (lictory doctor suggests it):")
    notes+=("   sudo lictory install --trusted-proxies <ip>   (docs/operations/reverse-proxy.md)")
  fi
  [ "$(current_tls)" = http ] &&
    notes+=("Plain HTTP: session cookies are not Secure. Use it on a trusted machine only (docs/operations/reverse-proxy.md).")
  notes+=("Check the installation at any time: lictory doctor")
  notes+=("Upgrades: lictory upgrade (channel: $(channel_of_environment))")
  local line
  for line in "${notes[@]}"; do
    case "$line" in "   "*) say "$line" ;; *) say "$g_bullet  $line" ;; esac
  done
}

# lictory admin <command>: instance administration from the server.
need_email() { # need_email <command>: the one positional email address
  [ ${#positional[@]} -eq 1 ] || usage_error "Usage: lictory admin $1 <email>"
  [[ "${positional[0]}" =~ $email_pattern ]] || usage_error "$1: ${positional[0]} is not an email address."
  printf '%s' "${positional[0]}" | tr '[:upper:]' '[:lower:]'
}
admin_ready() { # the api service must answer
  admin_status_json && return 0
  die "Lictory's api service did not answer ($(admin_message)). Is $environment running? Check: lictory status, lictory doctor"
}
# admin_do <success message> <admin.js args...>: one call, its error as a die.
admin_do() {
  local message="$1"
  shift
  admin_call "$@" </dev/null || die "$(admin_message)"
  check_ok "$message"
}
user_label() { printf '%s <%s>' "$(admin_value '.user.name')" "$(admin_value '.user.email')"; }

cmd_admin() {
  local sub="${1:-help}" email
  [ $# -eq 0 ] || shift
  command="admin $sub"
  case "$sub" in
    help | -h | --help)
      admin_usage
      return 0
      ;;
    setup)
      parse "organization organization-handle admin-name admin-email" "" "$@"
      [ ${#positional[@]} -eq 0 ] || usage_error "admin setup takes no arguments."
      select_environment
      [ "$(opt yes)" != true ] && [ -t 0 ] && interactive=true
      banner "first administrator"
      step "First administrator"
      first_administrator setup
      [ -z "$admin_email_created" ] || {
        say "Sign in at $(platform_url) as $admin_email_created, then open $(platform_url)/admin."
      }
      ;;
    status)
      parse "" "json" "$@"
      [ ${#positional[@]} -eq 0 ] || usage_error "admin status takes no arguments."
      select_environment
      admin_ready
      if [ "$(opt json)" = true ]; then
        printf '%s\n' "$admin_out"
        return 0
      fi
      print_access
      ;;
    list)
      parse "" "" "$@"
      [ ${#positional[@]} -eq 0 ] || usage_error "admin list takes no arguments."
      select_environment
      admin_call list-admins </dev/null || die "$(admin_message)"
      if [ "$(admin_value '.administrators | length')" = 0 ]; then
        say "No instance administrator yet: sudo lictory admin setup"
        return 0
      fi
      admin_value '.administrators[] | "\(.name) <\(.email)>\(if .deactivated then "  (deactivated)" else "" end)"' |
        while IFS= read -r line; do say "$g_bullet $line"; done
      ;;
    grant | revoke)
      parse "" "" "$@"
      email=$(need_email "$sub")
      select_environment
      if [ "$sub" = revoke ]; then
        confirm "Remove instance administration from $email?" || die "Nothing changed."
      fi
      admin_call "$sub-admin" "$email" </dev/null || die "$(admin_message)"
      if [ "$(admin_value '.instanceAdmin')" = true ]; then
        check_ok "$(user_label) is an instance administrator."
      else
        check_ok "$(user_label) is no longer an instance administrator."
      fi
      ;;
    deactivate | reactivate)
      parse "" "" "$@"
      email=$(need_email "$sub")
      select_environment
      if [ "$sub" = deactivate ]; then
        confirm "Deactivate $email? They are signed out everywhere and cannot sign in until reactivated." || die "Nothing changed."
      fi
      admin_call "$sub" "$email" </dev/null || die "$(admin_message)"
      if [ "$(admin_value '.deactivated')" = true ]; then
        check_ok "$(user_label) is deactivated. Undo: lictory admin reactivate $email"
      else
        check_ok "$(user_label) can sign in again."
      fi
      ;;
    create-user)
      parse "name organization role" "admin" "$@"
      email=$(need_email create-user)
      select_environment
      [ "$(opt yes)" != true ] && [ -t 0 ] && interactive=true
      admin_ready
      ask name "Full name" ""
      [ -n "$(opt name)" ] || die "--name is required." 64
      local args=(create-user --email "$email" --name "$(opt name)") password="${LICTORY_USER_PASSWORD:-}"
      [ "$(opt admin)" != true ] || args+=(--admin)
      if [ -n "$(opt organization)" ]; then
        args+=(--organization "$(opt organization)")
        [ -z "$(opt role)" ] || args+=(--role "$(opt role)")
      elif [ -n "$(opt role)" ]; then
        usage_error "--role needs --organization <handle>."
      fi
      if [ -z "$password" ] && [ "$interactive" = true ] && [ "$(admin_value '.passwordLogin')" != false ]; then
        note "Set a password now, or leave it empty: they then use \"Forgot password\" (needs email) or single sign-on."
        prompt_line "Password (empty: none)" "" secret
        if [ -n "$answer" ]; then
          local first="$answer"
          [ -z "$(password_problem "$first")" ] || die "Password: $(password_problem "$first")." 64
          prompt_line "Repeat the password" "" secret
          [ "$answer" = "$first" ] || die "The passwords don't match." 64
          password="$first"
        fi
      fi
      if [ -n "$password" ]; then
        [ -z "$(password_problem "$password")" ] || die "Password: $(password_problem "$password")." 64
        args+=(--password-stdin)
        admin_call "${args[@]}" <<<"$password" || die "$(admin_message)"
      else
        admin_call "${args[@]}" </dev/null || die "$(admin_message)"
      fi
      check_ok "Created $(user_label)$([ "$(opt admin)" != true ] || printf ', an instance administrator')."
      [ "$(admin_value '.organization.name // empty')" = "" ] ||
        check_ok "Member of $(admin_value '.organization.name') ($(opt role | grep . || echo member))."
      ;;
    set-password)
      parse "" "" "$@"
      email=$(need_email set-password)
      select_environment
      [ "$(opt yes)" != true ] && [ -t 0 ] && interactive=true
      local password="${LICTORY_USER_PASSWORD:-}"
      if [ -z "$password" ]; then
        [ "$interactive" = true ] || die "Set the new password in LICTORY_USER_PASSWORD, or run on a terminal." 64
        ask_new_password "New password for $email"
        password="$new_password"
      fi
      [ -z "$(password_problem "$password")" ] || die "Password: $(password_problem "$password")." 64
      admin_call set-password "$email" --password-stdin <<<"$password" || die "$(admin_message)"
      check_ok "New password set for $(user_label); their sessions were signed out."
      ;;
    *) usage_error "Unknown admin command: $sub (lictory admin help)" ;;
  esac
}

# The access policy and counts from admin_out (admin.js status).
print_access() {
  local domains
  domains=$(admin_value '(.allowedEmailDomains // []) | join(", ")')
  say "accounts: $(signup_words "$(admin_value '.signUpMode')") (LICTORY_SIGNUP_MODE=$(admin_value '.signUpMode'))"
  say "email domains: ${domains:-any}"
  say "organizations: $(organization_words "$(admin_value '.organizationCreation')")"
  say "sign-in: $([ "$(admin_value '.passwordLogin')" = false ] && printf 'single sign-on only' || printf 'password')$([ -z "$(admin_value '.sso // empty')" ] || printf ', %s' "$(admin_value '.sso')")"
  say "administrators: $(admin_value '.administrators'), accounts: $(admin_value '.users'), organizations: $(admin_value '.organizations')"
}

# ------------------------------------------------------------------ bootstrap
# Called by deploy/get.sh with the bundle it copied out of a verified release.
cmd_bootstrap() {
  parse "bundle release-file deploy-user" "" "$@"
  require_root
  local bundle release_file user
  bundle=$(opt bundle)
  release_file=$(opt release-file)
  [ -f "$bundle/provision/install.sh" ] || die "--bundle must be a Lictory deployment bundle." 64
  [ -f "$release_file" ] || die "--release-file must be a release.env." 64
  environment=$(opt env)
  environment="${environment:-production}"
  user=$(deploy_user)
  step "Installing the Lictory host tooling ($(env_value "$release_file" LICTORY_VERSION))"
  LICTORY_ROOT="$root" DEPLOY_USER="$user" LICTORY_ENVIRONMENTS="$environment" \
    LICTORY_CLI_PATH="$cli_path" SHOW_NEXT_STEPS=false bash "$bundle/provision/install.sh"
  rm -rf "$root/share/.bundle.new"
  mkdir -p "$root/share"
  cp -R "$bundle" "$root/share/.bundle.new"
  cp "$release_file" "$root/share/.bundle.new/release.env"
  rm -rf "$root/share/bundle"
  mv "$root/share/.bundle.new" "$root/share/bundle"
  chown -R "$user" "$root/share" 2>/dev/null || true
  step "Ready"
  say "Install and start Lictory:  sudo lictory install"
  say "Without questions:          sudo lictory install --yes --host lictory.example.com --acme-email ops@example.com"
  say "Guide: https://github.com/$repository/blob/main/docs/operations/self-hosting.md"
}

# ---------------------------------------------------------- everyday commands
cmd_status() {
  parse "" "json" "$@"
  [ ${#positional[@]} -eq 0 ] || usage_error "status takes no arguments."
  select_environment
  if [ "$(opt json)" = true ]; then
    deploy_sh status --json
  else
    deploy_sh status
    say "url: $(platform_url)"
    say "channel: $(channel_of_environment)"
    # The access policy comes from the running api; status works without it.
    if admin_status_json; then
      print_access
    else
      say "access: unknown (the api service did not answer)"
    fi
  fi
}

cmd_upgrade() {
  parse "" "" "$@"
  [ ${#positional[@]} -le 1 ] || usage_error "upgrade takes at most one version."
  local target="${positional[0]:-}" reason active channel file order
  if [ -n "$target" ]; then
    reason=$(invalid_reason version "$target") || true
    [ -z "$reason" ] || usage_error "version: $reason"
  fi
  select_environment
  active=$(current_version)
  [ -n "$active" ] || die "$environment has no active release. Run: sudo lictory install"
  channel=$(channel_of_environment)
  resolve_release "$channel" "$target"
  order=$(semver_cmp "$release_version" "$active")
  if [ "$order" = 0 ]; then
    say "$environment already runs $active, the newest $channel release."
    return 0
  fi
  [ "$order" = 1 ] ||
    die "$release_version is older than the active $active. Upgrades only move forward (migrations are never reverted); to return to the previous release use: lictory rollback"
  say "Upgrade $environment: $active -> $release_version ($channel)"
  say "Release notes: $release_notes"
  confirm "Continue?" || die "Upgrade cancelled."
  file=$(mktemp)
  fetch_release "$file"
  pull_release_images "$file"
  # deploy.sh takes a backup before pending migrations and keeps the
  # previous release serving if anything fails.
  deploy_sh release <"$file" || {
    rm -f "$file"
    die "The upgrade to $release_version did not activate; $environment keeps its previous images. See the messages above and run: lictory doctor"
  }
  rm -f "$file"
  refresh_share
  say "$environment runs $release_version."
}

cmd_rollback() {
  parse "" "" "$@"
  [ ${#positional[@]} -eq 0 ] || usage_error "rollback takes no arguments."
  select_environment
  say "Rollback switches application images only; database migrations stay applied."
  confirm "Roll $environment back from $(current_version) to the previously activated release?" || die "Rollback cancelled."
  deploy_sh rollback
}

cmd_backup() {
  parse "" "" "$@"
  [ ${#positional[@]} -eq 0 ] || usage_error "backup takes no arguments."
  select_environment
  [ "$(setting LICTORY_DATABASE)" != external ] ||
    die "$environment uses an external database: Lictory takes no backups of it. Use your provider's backups and point-in-time recovery (docs/operations/external-database.md#backups)."
  [ "$(setting BACKUP_TARGET)" != none ] || die "Backups are disabled (BACKUP_TARGET=none). Choose a target: sudo lictory install --backup local"
  as_deploy "$bin/lictory-backup" "$environment" manual
}

cmd_logs() {
  parse "tail" "follow" "$@"
  [ ${#positional[@]} -le 1 ] || usage_error "logs takes at most one service."
  local service="${positional[0]:-}" args
  [ -z "$service" ] || word_in "$service" "$all_services" || usage_error "Unknown service $service (one of: $all_services)."
  select_environment
  [ -z "$service" ] || word_in "$service" "$(services_of_environment)" ||
    die "$environment has no $service service: its database is external (LICTORY_DATABASE=external)." 64
  args=(logs --tail "$(opt tail)")
  [ -n "$(opt tail)" ] || args=(logs --tail 200)
  [ "$(opt follow)" != true ] || args+=(--follow)
  [ -z "$service" ] || args+=("$service")
  compose "${args[@]}"
}

cmd_registry_login() {
  parse "username" "" "$@"
  [ ${#positional[@]} -eq 0 ] || usage_error "registry-login takes no arguments."
  select_environment
  local registry host user token
  registry=$(setting LICTORY_IMAGE_REGISTRY)
  host="${registry%%/*}"
  host="${host:-ghcr.io}"
  user=$(opt username)
  if [ -z "$user" ]; then
    [ -t 0 ] || die "Pass --username (the token is read from stdin)." 64
    printf 'Registry user for %s: ' "$host" >/dev/tty
    IFS= read -r user </dev/tty
  fi
  [ -z "$(invalid_reason username "$user")" ] || die "Invalid user name." 64
  if [ -t 0 ]; then
    printf 'Token (for GHCR a GitHub token with read:packages): ' >/dev/tty
    IFS= read -r -s token </dev/tty
    printf '\n' >/dev/tty
  else
    IFS= read -r token || true
  fi
  [ -n "$token" ] || die "No token given."
  printf '%s\n' "$token" | as_deploy docker login "$host" --username "$user" --password-stdin
  if is_root; then
    # get.sh pulls the bootstrap image as root.
    printf '%s\n' "$token" | docker login "$host" --username "$user" --password-stdin >/dev/null
  fi
}

# ---------------------------------------------------------------------- restore
cmd_restore() {
  parse "" "drill" "$@"
  [ ${#positional[@]} -ge 1 ] && [ ${#positional[@]} -le 2 ] ||
    usage_error "Usage: lictory restore <identity-file|none> [latest|<key>|<file>] [--drill]"
  local identity="${positional[0]}" source="${positional[1]:-latest}"
  [ "$identity" = none ] || [ -r "$identity" ] || die "Cannot read the backup identity $identity."
  select_environment
  local active
  active=$(current_version)
  [ -n "$active" ] || die "$environment has no active release; install it first (sudo lictory install), then restore."
  if [ "$(opt drill)" = true ]; then
    local copy="$identity"
    if [ "$identity" != none ] && is_root; then
      # A private copy the deploy user can read (the identity may be root's).
      copy=$(as_deploy mktemp)
      cat "$identity" >"$copy"
    fi
    local status=0
    as_deploy "$bin/lictory-restore-drill" "$environment" "$copy" "$source" || status=$?
    [ "$copy" = "$identity" ] || rm -f "$copy"
    return "$status"
  fi
  [ "$(setting LICTORY_DATABASE)" != external ] ||
    die "$environment uses an external database: restore it with your provider's point-in-time recovery or snapshots, then run lictory install (docs/operations/external-database.md#backups)."
  require_root
  local project="lictory-$environment" stamp keep work db image mounts=() target="$source"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  keep="${project}_postgres_data-before-restore-$stamp"
  db=$(setting LICTORY_DB_NAME)
  say "This replaces the database of $environment with backup '$source'."
  say "Writes since that backup are lost. The current data is kept in the Docker volume $keep."
  if [ "$(opt yes)" != true ]; then
    [ -t 0 ] || die "Not confirmed: pass --yes to run without questions."
    local answer
    printf 'Type the environment name (%s) to continue: ' "$environment" >/dev/tty
    IFS= read -r answer </dev/tty || true
    [ "$answer" = "$environment" ] || die "Restore cancelled."
  fi
  work=$(as_deploy mktemp -d)
  trap 'rm -rf "$work"' EXIT
  # Readable by the ops container's postgres user; the directory stays private.
  if [ "$identity" = none ]; then : >"$work/age-identity"; else cp "$identity" "$work/age-identity"; fi
  chmod 0644 "$work/age-identity"
  mounts=(-v "$work/age-identity:/run/age-identity:ro")
  if [ -f "$source" ]; then
    cp "$source" "$work/"
    case "$source" in *.dump.age) cp "${source%.dump.age}.manifest.json.age" "$work/" ;; *.dump) cp "${source%.dump}.manifest.json" "$work/" ;; esac ||
      die "The backup's manifest must sit next to $source."
    chmod 0644 "$work"/*
    mounts+=(-v "$work:/restore-source:ro")
    target="/restore-source/$(basename "$source")"
  fi
  image=$(compose config --format json | jq -er '.services.postgres.image') || die "Could not resolve the PostgreSQL image."
  step "Stopping $environment"
  compose stop proxy api worker zero-cache postgres
  step "Keeping the current database in $keep"
  docker volume create "$keep" >/dev/null
  docker run --rm --network none --entrypoint cp -v "${project}_postgres_data:/from:ro" -v "$keep:/to" "$image" -a /from/. /to/ ||
    die "Could not copy the current database; nothing was changed. Start it again: lictory install"
  trap 'rm -rf "$work"; printf "\nRestore failed. The previous database is in the Docker volume %s.\n" "$keep" >&2' EXIT
  compose rm -fs postgres zero-cache >/dev/null
  docker volume rm "${project}_postgres_data" >/dev/null || die "Could not remove the old database volume."
  # zero-cache resyncs from the restored database.
  docker volume rm "${project}_zero_replica" >/dev/null 2>&1 || true
  step "Restoring"
  compose up -d --wait --wait-timeout 180 postgres
  RESTORE_PGPASSWORD=$(setting POSTGRES_SUPERUSER_PASSWORD) compose run --rm --no-deps -T "${mounts[@]}" \
    -e AGE_IDENTITY_FILE=/run/age-identity -e RESTORE_PGHOST=postgres -e RESTORE_PGUSER=postgres \
    -e RESTORE_PGPASSWORD -e RESTORE_DATABASE="$db" ops sh -c 'restore.sh "$1" && verify.sh' restore "$target"
  step "Starting $active on the restored database"
  deploy_sh migrate "$active"
  deploy_sh activate "$active"
  trap 'rm -rf "$work"' EXIT
  say "Restored. Check the data, then remove the previous database: docker volume rm $keep"
}

# --------------------------------------------------------------------- database
# The release's database.mjs (the `database` Compose service) with the
# connections the services use: requirements, role setup and grants.
has_database_tool() { compose --profile tools config --services 2>/dev/null | grep -qx database; }

# database_checks: the requirements as doctor checks (pass, warn, fail).
database_checks() {
  local json line status detail fix
  if ! has_database_tool; then
    check_warn "This release cannot check the database's requirements; upgrade to check them (lictory upgrade)."
    return 0
  fi
  json=$(compose run --rm --no-deps -T database check --json 2>/dev/null | tail -n 1) || true
  if ! printf '%s' "$json" | jq -e .checks >/dev/null 2>&1; then
    check_fail "The database requirements could not be checked: sudo lictory database check"
    return 0
  fi
  while IFS=$'\t' read -r status line detail fix; do
    case "$status" in
      pass) check_ok "$line" ;;
      warn) check_warn "$line: $detail${fix:+ Fix: $fix}" ;;
      fail) check_fail "$line: $detail${fix:+ Fix: $fix}" ;;
    esac
  done < <(printf '%s' "$json" | jq -r '.checks[] | select(.status != "skip") | [.status, .requirement, .detail, (.fix // "")] | @tsv')
}

cmd_database() {
  local sub="${1:-}"
  [ $# -eq 0 ] || shift
  case "$sub" in
    check)
      parse "" "json" "$@"
      [ ${#positional[@]} -eq 0 ] || usage_error "database check takes no arguments."
      select_environment
      [ -n "$(current_version)" ] || [ -n "$(newest_prepared)" ] || die "$environment has no release yet: sudo lictory install"
      release_compose run --rm --no-deps -T database check $([ "$(opt json)" != true ] || echo --json)
      ;;
    setup)
      parse "database-admin-url" "" "$@"
      [ ${#positional[@]} -eq 0 ] || usage_error "database setup takes no arguments (the administrator URL comes from LICTORY_DATABASE_ADMIN_URL or a prompt)."
      select_environment
      [ "$(setting LICTORY_DATABASE)" = external ] ||
        die "$environment uses the bundled database, whose roles deploy.sh maintains. database setup is for an external database (LICTORY_DATABASE=external)."
      [ -n "$(current_version)" ] || [ -n "$(newest_prepared)" ] || die "$environment has no release yet: sudo lictory install"
      if [ -z "$(opt database-admin-url)" ]; then
        [ -t 0 ] || die "Set LICTORY_DATABASE_ADMIN_URL to an administrator connection (a role that may create roles and databases)." 64
        interactive=true
        say "An administrator connection creates Lictory's roles and databases on $(setting DATABASE_HOST); it is used once and not stored."
        ask database-admin-url "Administrator connection URL (postgresql://user:password@host:port/database?sslmode=verify-full)" "" secret
        [ -n "$(opt database-admin-url)" ] || die "No administrator connection given."
      fi
      DATABASE_ADMIN_URL=$(opt database-admin-url) release_compose run --rm --no-deps -T -e DATABASE_ADMIN_URL database setup ||
        die "The role setup did not finish; see the messages above (docs/operations/external-database.md#roles)."
      say "Checking the requirements:"
      release_compose run --rm --no-deps -T database check
      ;;
    "" | help | -h | --help)
      say "Usage: lictory database check [--json] | setup"
      ;;
    *) usage_error "Unknown database command: $sub (check or setup)." ;;
  esac
}
# The release prepared most recently, for commands that run before the first
# activation (a failed first install).
newest_prepared() {
  local dir
  # shellcheck disable=SC2012 # release directories are version numbers
  for dir in $(ls -1td "$home"/releases/*/ 2>/dev/null); do
    [ -f "$dir/release.env" ] && [ -f "$dir/compose.production.yaml" ] || continue
    printf '%s' "${dir%/}"
    return 0
  done
}
release_compose() {
  if [ -n "$(current_version)" ]; then
    compose "$@"
  else
    as_deploy env LICTORY_RELEASE_DIR="$(newest_prepared)" "$bin/lictory-compose" "$environment" "$@"
  fi
}

# ----------------------------------------------------------------------- doctor
cmd_doctor() {
  parse "" "" "$@"
  [ ${#positional[@]} -eq 0 ] || usage_error "doctor takes no arguments."
  select_environment
  local tls host url status_json state version insecure=() mode gateway
  step "Host"
  preflight
  step "Configuration ($home/.env)"
  mode=$(stat -c %a "$home/.env" 2>/dev/null || stat -f %Lp "$home/.env")
  [ "$mode" = 600 ] && check_ok ".env is private (0600)" || check_fail ".env has mode $mode: chmod 0600 $home/.env"
  if grep -q '=generate$' "$home/.env"; then check_fail "unreplaced 'generate' placeholders in .env"; fi
  host=$(setting APP_HOST)
  [ -n "$host" ] && check_ok "host $host" || check_fail "APP_HOST is empty: sudo lictory install --host <name>"
  tls=$(current_tls)
  check_ok "TLS mode $tls, address $(platform_url)"
  case "$(setting LICTORY_IMAGE_REGISTRY)" in
    "" | *replace-with-owner*) check_fail "LICTORY_IMAGE_REGISTRY is not set: sudo lictory install" ;;
  esac
  case "$(current_email)" in
    none) check_warn "No outbound email: verification, invitations and password reset are not delivered (sudo lictory install --email smtp)." ;;
    *) check_ok "outbound email via $(current_email)" ;;
  esac
  if [ "$(setting LICTORY_DATABASE)" = external ]; then
    check_ok "external database $(setting DATABASE_HOST):$(setting DATABASE_PORT | grep . || echo 5432) (sslmode $(setting DATABASE_SSLMODE | grep . || echo verify-full)); backups are the provider's"
  else case "$(setting BACKUP_TARGET)" in
    none) check_warn "Backups are disabled (BACKUP_TARGET=none)." ;;
    local) [ -n "$(setting BACKUP_LOCAL_PATH)" ] && check_ok "backups to $(setting BACKUP_LOCAL_PATH)" ||
      check_warn "Backups stay on this server's disk; add a NAS path, s3 or rclone target for disaster recovery." ;;
    *) check_ok "backups to $(setting BACKUP_TARGET)" ;;
  esac
  case "$(setting BACKUP_AGE_RECIPIENTS)" in
    none) [ "$(setting BACKUP_TARGET)" = none ] || check_warn "Backups are not encrypted (BACKUP_AGE_RECIPIENTS=none)." ;;
    age1*) ;;
    *) [ "$(setting BACKUP_TARGET)" = none ] || check_fail "BACKUP_AGE_RECIPIENTS is not an age public key: backups fail (sudo lictory install --backup-age-recipient generate)." ;;
  esac
  fi
  if [ "$tls" = proxy ] && [ -z "$(setting CADDY_TRUSTED_PROXIES)" ]; then
    gateway=$(docker network inspect "lictory-${environment}_edge" --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null || true)
    check_warn "CADDY_TRUSTED_PROXIES is empty: every user shares one sign-in rate limit.${gateway:+ A proxy on this host connects from $gateway: sudo lictory install --trusted-proxies $gateway}"
  fi
  [ "$tls" = acme ] || [ "$tls" = internal ] && check_dns "$host"

  step "Release"
  version=$(current_version)
  if [ -z "$version" ]; then
    check_fail "No active release: sudo lictory install"
  else
    status_json=$(deploy_sh status --json 2>/dev/null) || status_json=""
    if [ -z "$status_json" ]; then
      check_fail "deploy.sh status failed: $bin/deploy.sh $environment status"
    else
      check_ok "release $version ($(printf '%s' "$status_json" | jq -r .channel))"
      for service in $(services_of_environment); do
        state=$(printf '%s' "$status_json" | jq -r --arg s "$service" '.services[$s] // "missing"')
        case "$state" in
          running | running/healthy) check_ok "$service $state" ;;
          *) check_fail "$service is $state: lictory logs $service" ;;
        esac
      done
      [ "$(printf '%s' "$status_json" | jq -r .healthy)" = true ] ||
        check_warn "Not every service runs the release's images: lictory install re-activates $version."
    fi
  fi

  step "Routes and certificates"
  url="$(platform_url)/readyz"
  [ -z "$(setting CADDY_GLOBAL_OPTIONS)" ] || insecure=(-k)
  if curl -fsS ${insecure[@]+"${insecure[@]}"} -m 15 -o /dev/null "$url" 2>/dev/null; then
    check_ok "$url"
  else
    local port scheme
    scheme=$(setting PROXY_SCHEME)
    scheme="${scheme:-https}"
    if [ "$scheme" = http ]; then port=$(setting HTTP_PORT); port="${port:-80}"; else port=$(setting HTTPS_PORT); port="${port:-443}"; fi
    if curl -fsS -k -m 15 -o /dev/null --resolve "$host:$port:127.0.0.1" "$scheme://$host:$port/readyz" 2>/dev/null; then
      check_fail "$url is not reachable, but the gateway answers locally: check DNS, the firewall (ports 80/443)${insecure:+, your CA}$([ "$tls" = proxy ] && printf ' and your reverse proxy')."
    else
      check_fail "The gateway does not answer on port $port: lictory logs proxy"
    fi
  fi
  if [ "$tls" = acme ] || [ "$tls" = internal ]; then
    local expiry
    expiry=$(printf '' | openssl s_client -connect 127.0.0.1:"$(setting HTTPS_PORT | grep . || echo 443)" -servername "$host" 2>/dev/null |
      openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)
    if [ -n "$expiry" ]; then check_ok "certificate valid until $expiry"; else check_warn "No certificate served for $host yet: lictory logs proxy"; fi
  fi

  if [ -n "$version" ]; then
    step "Database, replication and background work"
    database_checks
    local report
    if report=$(compose run --rm --no-deps -T ops sh -c '
      [ -n "${PGSSLROOTCERT:-}" ] || [ "${PGSSLMODE:-}" != verify-full ] || export PGSSLROOTCERT=system
      psql -X -A -t -F " | " -v ON_ERROR_STOP=1 -v slot_lag_bytes="${MONITOR_SLOT_LAG_ALERT_BYTES:-2147483648}" \
        -v wal_bytes="${MONITOR_WAL_ALERT_BYTES:-6442450944}" -f /opt/lictory/sql/checks.sql
      echo "backup | $(jq -r .completed_at /backups/last-success.json 2>/dev/null || echo none)"' 2>&1); then
      local problems=0 line
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
          "backup | none") [ "$(setting BACKUP_TARGET)" = none ] || [ "$(setting LICTORY_DATABASE)" = external ] || check_warn "No successful backup yet: lictory backup" ;;
          "backup | "*) check_ok "last backup ${line#backup | }" ;;
          *) check_fail "$line"; problems=$((problems + 1)) ;;
        esac
      done <<<"$report"
      [ "$problems" -gt 0 ] || check_ok "replication slot, WAL and queued work"
    else
      check_fail "The database checks could not run: $(printf '%s' "$report" | tail -n 3 | tr '\n' ' ')"
    fi
  fi

  step "Access"
  local mode creation count
  mode=$(setting LICTORY_SIGNUP_MODE)
  mode="${mode:-invite}"
  creation=$(setting LICTORY_ORGANIZATION_CREATION)
  if [ "$mode" = open ] && [ "$tls" != http ]; then
    check_warn "Open sign-up: anyone who can reach $(platform_url) can create an account. Restrict it: sudo lictory install --signup-mode invite"
  else
    check_ok "accounts: $(signup_words "$mode")"
  fi
  [ -z "$(setting LICTORY_ALLOWED_EMAIL_DOMAINS)" ] || check_ok "new accounts limited to $(setting LICTORY_ALLOWED_EMAIL_DOMAINS)"
  check_ok "organizations: $(organization_words "$creation")"
  if [ -n "$version" ]; then
    if admin_status_json; then
      count=$(admin_value '.administrators')
      if [ "$count" -gt 0 ] 2>/dev/null; then
        check_ok "$count instance administrator(s) (lictory admin list)"
      else
        check_warn "No active instance administrator: nobody can manage accounts. Fix: sudo lictory admin setup (or sudo lictory admin grant <email>)"
      fi
    else
      check_warn "Could not ask the api service for administrators ($(admin_message)): lictory logs api"
    fi
  fi

  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null; then
    step "Timers"
    for unit in "lictory-backup@$environment.timer" "lictory-monitor@$environment.timer"; do
      systemctl is-active --quiet "$unit" && check_ok "$unit" || check_warn "$unit is not active: sudo systemctl start $unit"
    done
  fi

  printf '\n%s failure(s), %s warning(s).\n' "$failures" "$warnings"
  [ "$failures" -eq 0 ]
}

# ------------------------------------------------------------------------ main
command="${1:-help}"
[ $# -eq 0 ] || shift
case "$command" in
  install) cmd_install "$@" ;;
  admin) cmd_admin "$@" ;;
  bootstrap) cmd_bootstrap "$@" ;;
  status) cmd_status "$@" ;;
  doctor) cmd_doctor "$@" ;;
  database) cmd_database "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  rollback) cmd_rollback "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  logs) cmd_logs "$@" ;;
  registry-login) cmd_registry_login "$@" ;;
  help | -h | --help) usage ;;
  *) usage_error "Unknown command: $command" ;;
esac

#!/usr/bin/env bash
# Host side of the five-minute monitor (systemd: lictory-monitor@<env>.timer).
# Adds what only the host can see (disk usage, container states) and runs
# monitor.sh in the ops container, which alerts and pings. If the container
# cannot run at all (Docker or PostgreSQL down), alerts directly from here.
set -uo pipefail

environment="${1:?Usage: lictory-monitor <environment>}"
root="${LICTORY_ROOT:-/srv/lictory}"
home="$root/$environment"
bin="$(cd "$(dirname "$0")" && pwd)"
setting() { grep -E "^$1=" "$home/.env" | tail -n 1 | cut -d= -f2- | sed -e "s/^['\"]//" -e "s/['\"]\$//"; }
# JSON string without python or jq: escapes backslash, quote and control
# characters (newlines and tabs as \n and \t, others dropped).
json_string() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/}"
  s="${s//$'\t'/\\t}"
  printf '"%s"' "$(printf '%s' "$s" | tr -d '\000-\010\013-\037')"
}
report=""

threshold="${DISK_ALERT_PERCENT:-80}"
for path in / "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"; do
  [ -d "$path" ] || continue
  used=$(df -P "$path" | awk 'NR == 2 { gsub("%", "", $5); print $5 }')
  [ "${used:-0}" -gt "$threshold" ] && report="${report}disk $path is ${used}% full (alert above ${threshold}%)
"
done

for service in postgres zero-cache api worker proxy; do
  id=$(LICTORY_ROOT="$root" "$bin/lictory-compose" "$environment" ps -q "$service" 2>/dev/null)
  state=$(docker inspect --format '{{.State.Status}}{{if .State.Health}}/{{.State.Health.Status}}{{end}}' "$id" 2>/dev/null || echo missing)
  case "$state" in running | running/healthy) ;; *) report="${report}container $service is $state
" ;; esac
done

# Frontends may have their own release lifecycle (Cloudflare). Check the
# public routes here, without making backend activation depend on a frontend
# release. Without a marketing site (SITE_HOST empty) there is nothing to probe.
site=$(setting SITE_HOST)
app=$(setting PUBLIC_APP_HOST)
app="${app:-$(setting APP_HOST)}"
urls=("https://$app/readyz")
[ -z "$site" ] || urls=("https://$site/" "${urls[@]}")
for url in "${urls[@]}"; do
  curl -fsS -m 15 -o /dev/null "$url" 2>/dev/null || report="${report}public route $url is not healthy
"
done

LICTORY_ROOT="$root" "$bin/lictory-compose" "$environment" run --rm --no-deps -T \
  -e HOST_REPORT="$report" ops monitor.sh
status=$?
if [ "$status" -ne 0 ] && [ "$status" -ne 1 ]; then
  url=$(setting ALERT_WEBHOOK_URL)
  message="[lictory $environment] monitor could not run (exit $status). Host report: ${report:-none}"
  echo "$message" >&2
  if [ -n "$url" ]; then
    body=$(json_string "$message")
    curl -fsS -m 10 -H 'Content-Type: application/json' --data-raw "{\"text\":$body,\"content\":$body}" "$url" >/dev/null || true
  fi
  ping=$(setting MONITOR_PING_URL)
  [ -n "$ping" ] && curl -fsS -m 10 --data-raw "$message" "$ping/fail" >/dev/null || true
fi
exit "$status"

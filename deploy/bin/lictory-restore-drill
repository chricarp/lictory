#!/usr/bin/env bash
# Restore drill: restores a backup into an isolated, throwaway stack and
# verifies it (row counts and migration history against the backup manifest,
# migration runner up to date, API ready). Never touches the live database.
#
#   lictory-restore-drill <environment> <age-identity-file|none> [latest|<key>|<file>]
#
# Run monthly and after changes to backups or migrations. The identity file is
# the offline private key; delete any temporary copy afterwards. `none` drills
# unencrypted backups (BACKUP_AGE_RECIPIENTS=none). The backup is read from the
# environment's BACKUP_TARGET (s3, local or rclone).
set -euo pipefail

environment="${1:?Usage: lictory-restore-drill <environment> <age-identity-file|none> [latest|<key>]}"
identity="${2:?Usage: lictory-restore-drill <environment> <age-identity-file|none> [latest|<key>]}"
source="${3:-latest}"
root="${LICTORY_ROOT:-/srv/lictory}"
home="$root/$environment"
release="${LICTORY_RELEASE_DIR:-$home/current}"
project="lictory-$environment-restore-drill"
if [ "$identity" != none ]; then
  [ -r "$identity" ] || { echo "Cannot read $identity" >&2; exit 1; }
  identity="$(cd "$(dirname "$identity")" && pwd)/$(basename "$identity")"
fi

# env_value <file> <key>: the last assignment of <key>, decoded as Docker
# Compose reads .env files: an optional "export ", spaces around "=", a
# double-quoted value with \n \t \r \\ \" \$ escapes, a single-quoted value
# with \' escapes, or an unquoted value up to " # comment". Keep the copies
# in deploy/bin/lictory, deploy.sh, lictory-backup, lictory-monitor and
# lictory-restore-drill identical (packages/core/src/release/self-host.test.ts).
env_value() {
  local line value out="" char next quote i=0
  line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?$2[[:space:]]*=" "$1" 2>/dev/null | tail -n 1) || true
  [ -n "$line" ] || return 0
  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"
  case "$value" in
    \"* | \'*)
      quote="${value:0:1}"
      value="${value:1}"
      while [ "$i" -lt "${#value}" ]; do
        char="${value:i:1}"
        if [ "$char" = '\' ] && [ $((i + 1)) -lt "${#value}" ]; then
          next="${value:i+1:1}"
          if [ "$quote" = '"' ]; then
            case "$next" in
              n) out="$out"$'\n' ;;
              t) out="$out"$'\t' ;;
              r) out="$out"$'\r' ;;
              '"' | '\' | '$') out="$out$next" ;;
              *) out="$out\\$next" ;;
            esac
          elif [ "$next" = "'" ]; then
            out="$out'"
          else
            out="$out\\$next"
          fi
          i=$((i + 2))
          continue
        fi
        [ "$char" != "$quote" ] || break
        out="$out$char"
        i=$((i + 1))
      done
      ;;
    *) out=$(printf '%s' "$value" | sed -E 's/[[:space:]]+#.*$//; s/[[:space:]]+$//') ;;
  esac
  printf '%s' "$out"
}
value() { env_value "$1" "$2"; }
# env_line <key> <value>: a line Compose reads back as exactly <value>
# (single quotes: no interpolation of $, no escapes).
env_line() {
  case "$2" in
    *"'"* | *'\')
      echo "$1 contains a single quote or ends with a backslash, which the drill cannot pass on; run it with a simpler value." >&2
      return 1
      ;;
  esac
  printf "%s='%s'\n" "$1" "$2"
}
secret() { openssl rand -hex 24; }
work=$(mktemp -d)
chmod 700 "$work"
drill_env="$work/drill.env"
# Readable by the container's unprivileged user; the directory stays private.
if [ "$identity" = none ]; then : >"$work/age-identity"; else cp "$identity" "$work/age-identity"; fi
chmod 644 "$work/age-identity"
# BACKUP_TARGET=local reads the live backup directory (read-only); other
# targets get an empty placeholder.
target=$(value "$home/.env" BACKUP_TARGET)
backup_source="$work/no-local-backups"
mkdir -p "$backup_source"
if [ "$target" = local ]; then
  backup_source=$(value "$home/.env" BACKUP_LOCAL_PATH)
  case "$backup_source" in
    "") backup_source=$(docker volume inspect --format '{{.Mountpoint}}' "lictory-${environment}_backups") ;;
    /*) ;;
    *) backup_source="$home/$backup_source" ;;
  esac
fi
{
  echo "LICTORY_ENVIRONMENT=$environment"
  echo "DRILL_DB_NAME=$(value "$home/.env" LICTORY_DB_NAME)"
  for name in SUPERUSER OWNER APP ZERO OPS; do echo "DRILL_${name}_PASSWORD=$(secret)"; done
  echo "DRILL_APP_SECRET=$(secret)"
  echo "DRILL_ROLES_SCRIPT=$release/bundle/postgres/10-lictory-roles.sh"
  echo "AGE_IDENTITY_FILE=$work/age-identity"
  echo "DRILL_BACKUP_SOURCE=$backup_source"
  for key in BACKUP_TARGET BACKUP_RCLONE_REMOTE BACKUP_BUCKET BACKUP_S3_PROVIDER BACKUP_S3_ENDPOINT BACKUP_S3_REGION BACKUP_S3_ACCESS_KEY_ID BACKUP_S3_SECRET_ACCESS_KEY; do
    env_line "$key" "$(value "$home/.env" "$key")" || exit 1
  done
  for key in OPS_IMAGE MIGRATE_IMAGE API_IMAGE; do echo "$key=$(value "$release/release.env" "$key")"; done
} >"$drill_env"
chmod 600 "$drill_env"

drill() {
  docker compose --project-name "$project" --project-directory "$work" \
    --file "$release/bundle/compose.restore-drill.yaml" --env-file "$drill_env" "$@"
}
cleanup() {
  drill --profile tools --profile app down -v --remove-orphans >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# A backup file on this host: the dump and its manifest are copied into the
# private work directory and bind-mounted one by one (the container cannot
# read host paths, nor traverse the 0700 directory).
source_mounts=()
if [ -f "$source" ]; then
  case "$source" in
    *.dump.age) manifest="${source%.dump.age}.manifest.json.age" ;;
    *.dump) manifest="${source%.dump}.manifest.json" ;;
    *) echo "$source is not a backup file (*.dump or *.dump.age)" >&2; exit 64 ;;
  esac
  [ -f "$manifest" ] || { echo "The backup's manifest must sit next to it: $manifest" >&2; exit 64; }
  for file in "$source" "$manifest"; do
    cat "$file" >"$work/$(basename "$file")"
    chmod 644 "$work/$(basename "$file")"
    source_mounts+=(-v "$work/$(basename "$file"):/restore-source/$(basename "$file"):ro")
  done
  source="/restore-source/$(basename "$source")"
fi

seconds() { date +%s; }
t0=$(seconds)
drill up -d --wait postgres >/dev/null
t1=$(seconds)
drill run --rm -T ${source_mounts[@]+"${source_mounts[@]}"} ops sh -c 'restore.sh "$1" && verify.sh' restore "$source"
t2=$(seconds)
status=$(drill run --rm -T migrate)
echo "$status"
echo "$status" | grep -q "up to date" || { echo "FAIL  migration runner reports pending or newer migrations" >&2; exit 1; }
echo "ok    migration runner: up to date"
drill --profile app up -d --wait --wait-timeout 120 api >/dev/null || {
  drill --profile app logs --tail 50 api >&2
  echo "FAIL  API did not become ready on the restored database" >&2
  exit 1
}
echo "ok    API ready on the restored database"
t3=$(seconds)
echo "Drill passed: start $((t1 - t0))s, download+restore+verify $((t2 - t1))s, application checks $((t3 - t2))s, total $((t3 - t0))s."

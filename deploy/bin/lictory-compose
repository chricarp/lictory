#!/usr/bin/env bash
# docker compose for one Lictory environment on this server.
#   lictory-compose <environment> <compose arguments...>
#
# Uses the active release (<home>/current -> releases/<version>): its compose
# file (plus compose.external-database.yaml with LICTORY_DATABASE=external) and
# image digests (release.env), plus the environment's .env.
# LICTORY_RELEASE_DIR selects another release (deploy.sh while rolling).
set -euo pipefail

environment="${1:?Usage: lictory-compose <environment> <compose arguments...>}"
shift
# Environment names become paths, Compose project names and migration
# targets: lowercase letters, digits and hyphens. local, test and preview are
# reserved by the migration runner (packages/core/src/db/migration-safety.ts).
valid_environment() {
  [[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]] && case "$1" in local | test | preview) false ;; esac
}
valid_environment "$environment" || {
  echo "Unknown environment: $environment" >&2
  exit 64
}
home="${LICTORY_ROOT:-/srv/lictory}/$environment"
release="${LICTORY_RELEASE_DIR:-$home/current}"
[ -f "$home/.env" ] || { echo "Missing $home/.env" >&2; exit 1; }
[ -f "$release/release.env" ] || {
  echo "No release at $release; deploy one with lictory-deploy." >&2
  exit 1
}

# LICTORY_DATABASE=external: the database runs elsewhere (a managed service
# or your own server); the release's override removes the bundled postgres.
files=(--file "$release/compose.production.yaml")
database=$(grep -E '^LICTORY_DATABASE=' "$home/.env" | tail -n 1 | cut -d= -f2- | tr -d "\"'" || true)
case "${database:-bundled}" in
  bundled) ;;
  external)
    [ -f "$release/compose.external-database.yaml" ] || {
      echo "The release at $release does not support an external database (LICTORY_DATABASE=external); install a newer release." >&2
      exit 1
    }
    files+=(--file "$release/compose.external-database.yaml")
    ;;
  *)
    echo "LICTORY_DATABASE must be bundled or external (got $database) in $home/.env." >&2
    exit 64
    ;;
esac

exec docker compose \
  --project-name "lictory-$environment" \
  --project-directory "$home" \
  "${files[@]}" \
  --env-file "$home/.env" \
  --env-file "$release/release.env" \
  "$@"

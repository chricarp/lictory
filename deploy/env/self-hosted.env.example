# A self-hosted Lictory environment. `lictory install` copies this file to
# <root>/<environment>/.env (mode 0600, owner: the deploy user), fills every
# `generate` value with `openssl rand -hex 32` and sets the values it asks for.
# Re-running `lictory install` changes only what you answer differently; edit
# anything else here by hand, then `lictory install` (or `deploy.sh <env>
# activate <version>`) applies it. See docs/operations/self-hosting.md.
# Values run to the end of the line; wrap values containing `$` or ` #` in
# single quotes (Compose interpolation). Never commit real values.

LICTORY_ENVIRONMENT=production
LICTORY_HOME=/srv/lictory/production

# The one host name users open (DNS points at this server or at your proxy).
# No marketing site: links to "the website" go to the app itself.
APP_HOST=
ACME_EMAIL=
# Set by `lictory install --tls proxy|internal|http`; empty for automatic
# HTTPS (docs/operations/reverse-proxy.md).
PLATFORM_URL=
PROXY_SCHEME=
HTTP_PORT=
HTTP_BINDING=
HTTPS_BINDING=
CADDY_GLOBAL_OPTIONS=
# Space-separated IPs/CIDRs of the proxies in front of the gateway; empty
# trusts none (standalone).
CADDY_TRUSTED_PROXIES=

# PostgreSQL (internal network only; deploy/postgres/10-lictory-roles.sh).
LICTORY_DB_NAME=lictory
POSTGRES_SUPERUSER_PASSWORD=generate
LICTORY_OWNER_PASSWORD=generate
LICTORY_APP_PASSWORD=generate
ZERO_DB_PASSWORD=generate
LICTORY_OPS_PASSWORD=generate

# Application secrets. Keep a copy in your password manager.
BETTER_AUTH_SECRET=generate
# Stable forever once Jira connections exist: rotating it makes stored
# delivery credentials unreadable.
DELIVERY_CREDENTIALS_KEY=generate
ZERO_API_KEY=generate
ZERO_ADMIN_PASSWORD=generate

# Outbound email: Resend (RESEND_*) or your SMTP server (SMTP_*: STARTTLS on
# 587, TLS from the first byte on 465 (SMTP_SECURE defaults to true there), or
# plain 25; SMTP_REQUIRE_TLS=true refuses to send without STARTTLS). Without
# either, invitations, verification and password reset email are not
# delivered and the services log a warning. A transport needs a sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional attachment bucket on any S3-compatible service (or the R2_*
# preset instead); without one, attachments are disabled. The endpoint must
# be reachable from browsers: docs/internals/file-storage.md.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_S3_ENDPOINT=

# Company single sign-on (OpenID Connect): docs/operations/sso.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
OIDC_DISPLAY_NAME=
OIDC_AUTO_CREATE_USERS=
# false makes an SSO-only installation (requires an identity provider).
PASSWORD_LOGIN_ENABLED=

# Optional integrations; each stays off until configured.
OPENAI_API_KEY=
LICTORY_AI_MODEL=
LICTORY_TRANSCRIPTION_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
ANALYTICS_CONSENT=

# Backups (docs/operations/recovery.md): local (BACKUP_LOCAL_PATH, or this
# server's own backups volume when empty), s3 (BACKUP_BUCKET + BACKUP_S3_*),
# rclone (BACKUP_RCLONE_REMOTE) or none. Encrypted with age to the public
# recipient(s) below; keep the private identity offline.
BACKUP_TARGET=local
BACKUP_LOCAL_PATH=
BACKUP_BUCKET=
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENTS=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Alerting (deploy/monitor): a Slack/Discord-compatible webhook and
# dead-man's-switch pings (healthchecks.io style: <url>, <url>/fail).
ALERT_WEBHOOK_URL=
MONITOR_PING_URL=
BACKUP_PING_URL=

# Sizing for a 4 GB server; see docs/operations/deployment.md.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_MEM_LIMIT=1536m
ZERO_MEM_LIMIT=1g
ZERO_NUM_SYNC_WORKERS=2
API_MEM_LIMIT=768m
API_HEAP_MB=512
WORKER_MEM_LIMIT=512m
WORKER_HEAP_MB=384

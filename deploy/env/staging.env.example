# Lictory staging environment: its own server, database, buckets, OAuth
# clients and secrets. Never reuse production values.
# deploy/provision/new-environment.sh copies
# this file to /srv/lictory/staging/.env (mode 0600, owner deploy) and fills
# every `generate` value with `openssl rand -hex 32`. Never commit real values.
# Values run to the end of the line; wrap values containing `$` or ` #` in
# single quotes (Compose interpolation).

LICTORY_ENVIRONMENT=staging
LICTORY_HOME=/srv/lictory/staging

# Public hosts (DNS A/AAAA records point at this server).
SITE_HOST=staging.lictory.com
WWW_HOST=www.staging.lictory.com
APP_HOST=app.staging.lictory.com
ACME_EMAIL=ops@lictory.com
# PLATFORM_URL: the public origin when it is not https://APP_HOST (behind
# another proxy, another port or plain HTTP); docs/operations/reverse-proxy.md.
# Empty in production. `local_certs` for a local drill, or
# `acme_ca https://acme-staging-v02.api.letsencrypt.org/directory` to test issuance.
CADDY_GLOBAL_OPTIONS=
# Space-separated proxy IPs/CIDRs; empty trusts no proxies. Behind an edge,
# set its actual peers and other proxy hops present in X-Forwarded-For.
CADDY_TRUSTED_PROXIES=

# PostgreSQL (internal network only; deploy/postgres/10-lictory-roles.sh).
LICTORY_DB_NAME=lictory_staging
POSTGRES_SUPERUSER_PASSWORD=generate
LICTORY_OWNER_PASSWORD=generate
LICTORY_APP_PASSWORD=generate
ZERO_DB_PASSWORD=generate
LICTORY_OPS_PASSWORD=generate

# Application secrets.
BETTER_AUTH_SECRET=generate
# Stable forever once Jira connections exist: rotating it makes stored
# delivery credentials unreadable.
DELIVERY_CREDENTIALS_KEY=generate
# Shared by zero-cache (X-Api-Key) and the API's /api/zero/* endpoints.
ZERO_API_KEY=generate
ZERO_ADMIN_PASSWORD=generate

# Email (Resend in production).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lictory <no-reply@staging.lictory.com>

# Private attachment bucket (optional; without one, attachments are disabled).
# Either the Cloudflare R2 preset with a bucket-scoped object read/write token:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lictory-staging-files
R2_S3_ENDPOINT=
# or, instead of every R2_* value, any S3-compatible service (AWS S3, MinIO,
# Garage, Ceph, Hetzner...). The endpoint must be reachable from browsers.
# See docs/internals/file-storage.md.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Optional integrations.
OPENAI_API_KEY=
LICTORY_AI_MODEL=
LICTORY_TRANSCRIPTION_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Company single sign-on (OpenID Connect): see docs/operations/sso.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
OIDC_DISPLAY_NAME=
OIDC_AUTO_CREATE_USERS=
# false makes an SSO-only installation (requires an identity provider).
PASSWORD_LOGIN_ENABLED=
OAUTH_PROXY_URL=
OAUTH_PROXY_SECRET=
OAUTH_PROXY_TRUSTED_ORIGINS=
# Optional product analytics: server events, and the platform's browser
# analytics (written into each page at runtime). Empty token: no analytics.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
# `strict`: no analytics before a person's consent, browser or server. Unset:
# cookieless anonymous analytics before consent (docs/internals/analytics.md).
ANALYTICS_CONSENT=

# Backups: dedicated private R2 bucket with its own bucket-scoped token
# (never the files bucket token). Encrypted on the server with age to the
# public recipient(s) below; the private identity is kept offline.
# BACKUP_TARGET: s3 (default; any S3 provider), local (BACKUP_LOCAL_PATH),
# rclone (BACKUP_RCLONE_REMOTE) or none. See docs/operations/recovery.md.
BACKUP_BUCKET=lictory-staging-backups
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENTS=age1replace-with-the-public-key
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Alerting (deploy/monitor): any HTTPS endpoint accepting a JSON POST
# (Slack/Discord/ntfy-compatible webhook), plus dead-man's-switch pings
# (healthchecks.io style: <url>, <url>/fail).
ALERT_WEBHOOK_URL=
MONITOR_PING_URL=
BACKUP_PING_URL=

# Sizing for a 4 GB staging server.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_MEM_LIMIT=1536m
ZERO_MEM_LIMIT=1g
ZERO_NUM_SYNC_WORKERS=1
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=512m

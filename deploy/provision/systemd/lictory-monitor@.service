[Unit]
Description=Lictory health and job monitor (%i)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=LICTORY_ROOT=/srv/lictory
ExecStart=/srv/lictory/bin/lictory-monitor %i
TimeoutStartSec=4min
# Exit status 1 means problems were found and reported.
SuccessExitStatus=1

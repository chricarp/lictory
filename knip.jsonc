{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Browser specs run `bun <runner cli> register|start`; knip reads the
  // runner's subcommands as binaries.
  "ignoreBinaries": ["register", "start"],
  "workspaces": {
    ".": {
      // Bun runs colocated tests; operators and the Better Auth CLI load these by path.
      "entry": [
        "scripts/*.ts",
        "scripts/backfills/*.ts",
        // Preloaded into the API and worker by scripts/test-e2e.ts.
        "scripts/e2e-fakes/route-fake-sites.ts",
        "tests/**/*.ts",
        "deploy/docker/*.mjs",
        "deploy/docker/src/*.test.mjs",
        "deploy/cloudflare/src/worker.ts",
        "deploy/cloudflare/src/*.test.ts",
        "better-auth.config.ts",
      ],
      "project": [
        "*.{ts,mjs}",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "deploy/**/*.mjs",
        "deploy/cloudflare/**/*.ts",
      ],
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts", "src/jobs/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/zero": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/marketing": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/docs": {
      "project": ["src/**/*.{ts,tsx}", "content/**/*.mdx"],
    },
    "apps/platform": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // Legacy suggestion views kept for existing history; remove each when its
      // follow-up lands. Do not add new entries without a reason.
      "ignore": [
        "src/components/review/suggestion-details.tsx",
        "src/components/review/suggestion-view.tsx",
        "src/components/review/suggestions.tsx",
      ],
    },
    "apps/api": {
      "entry": ["src/admin-cli.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/worker": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/desktop": {
      // esbuild bundles these (build.mjs); package.mjs and icons.mjs are run
      // by hand or by a release job.
      "entry": [
        "src/main/index.ts",
        "src/preload/*.ts",
        "src/renderer/shell.ts",
        "src/**/*.test.ts",
        "tests/*.spec.ts",
        "*.mjs",
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.{ts,mjs}"],
    },
    "apps/collaboration": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/runner": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
    },
  },
  // Exported types are contracts before they have consumers. Unused value
  // exports and duplicate (named + default) exports are not enforced yet.
  "rules": {
    "types": "off",
    "nsTypes": "off",
    "exports": "off",
    "enumMembers": "off",
    "duplicates": "off",
  },
}

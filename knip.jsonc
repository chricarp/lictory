{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Bun runs colocated tests; operators and the Better Auth CLI load these by path.
      "entry": [
        "scripts/*.ts",
        "tests/**/*.ts",
        "better-auth.config.ts",
      ],
      "project": ["*.{ts,mjs}", "scripts/**/*.ts", "tests/**/*.ts"],
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts", "src/jobs/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/zero": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/marketing": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/platform": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      // Legacy suggestion views kept for existing history; remove each when its
      // follow-up lands. Do not add new entries without a reason.
      "ignore": [
        "src/components/review/suggestion-details.tsx",
        "src/components/review/suggestion-view.tsx",
        "src/components/review/suggestions.tsx",
      ],
      // Self-hosted fonts are imported from CSS.
      "ignoreDependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
      ],
    },
    "apps/api": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/worker": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
  },
  // Tailwind is loaded through CSS.
  "ignoreDependencies": ["tailwindcss"],
  // Exported types are contracts before they have consumers. Unused value
  // exports and duplicate (named + default) exports are not enforced yet.
  "rules": {
    "types": "off",
    "nsTypes": "off",
    "exports": "off",
    "enumMembers": "off",
    "duplicates": "off",
  },
}

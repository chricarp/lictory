# Local development settings. Every variable, its default and which service
# reads it: docs/operations/configuration.md. Production rejects the
# placeholder secret below.

# Application
BETTER_AUTH_URL=http://localhost:3000
# Generate a production value with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-secret-change-before-production

# The installation's own legal notices (absolute URLs), linked at sign-up and
# from the consent banner. Unset: no acceptance notice and no legal links.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=

# The website's (lictory.com) operator, shown on its legal pages and compiled
# in at build time. Without a name and email the pages display a draft notice.
# These values are publicly displayed; never commit real ones.
# See docs/operations/legal.md.
LICTORY_LEGAL_NAME=
LICTORY_LEGAL_ADDRESS=
LICTORY_LEGAL_EMAIL=
# Optional: VAT / company or professional registration details, if applicable.
LICTORY_LEGAL_REGISTRATION=

# PostgreSQL (host value; Compose overrides this for the app container)
DATABASE_URL=postgresql://lictory:lictory@localhost:5432/lictory
# Direct (unpooled) PostgreSQL connection for realtime LISTEN/NOTIFY and local
# migrations, needed when DATABASE_URL goes through a transaction pooler.
# Leave empty locally to use DATABASE_URL for both.
DATABASE_URL_UNPOOLED=
# Migrations (bun run db:migrate). Locally they use the URLs above and only
# accept local hosts. Shared environments set these in GitHub environments.
# See docs/operations/migrations.md.
DATABASE_MIGRATION_TARGET=local
DATABASE_MIGRATION_URL=

# Transactional email. When RESEND_API_KEY is empty, local development falls
# back to the SMTP settings below and Mailpit captures every message.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lictory <no-reply@email.lictory.com>

# Local SMTP fallback (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Lictory <no-reply@lictory.local>

# OAuth providers are optional. Their buttons become active when both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lictory's Entra application; supply its secret through the deployment's secret store.
MICROSOFT_CLIENT_ID=674718cd-ca91-451c-84eb-02aa492d2b10
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Company single sign-on (OpenID Connect). For the local Dex identity provider
# (`docker compose --profile sso up -d dex`) use the values in
# docs/operations/sso.md. PASSWORD_LOGIN_ENABLED=false makes an SSO-only
# installation.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
OIDC_DISPLAY_NAME=
OIDC_AUTO_CREATE_USERS=
PASSWORD_LOGIN_ENABLED=

# Optional OAuth proxy for trusted local/preview deployments. The callback
# server and participants need the same URL, proxy secret and provider client.
# Keep BETTER_AUTH_SECRET separate per environment. See
# docs/operations/oauth-proxy.md for separate production/development clients.
OAUTH_PROXY_URL=
OAUTH_PROXY_SECRET=
# Comma-separated participating origins on the callback server. Use exact
# origins or a narrow project-specific pattern, never a wildcard over a shared
# hosting domain.
OAUTH_PROXY_TRUSTED_ORIGINS=

# Background worker (apps/worker): AI runs, notification email, delivery
# exports and status sync, automatic cycles. It LISTENs on DATABASE_URL_UNPOOLED
# (falls back to DATABASE_URL) and also polls. Every setting is optional.
# WORKER_AI_INTERVAL_MS=30000
# WORKER_EMAIL_INTERVAL_MS=30000
# WORKER_DELIVERY_INTERVAL_MS=30000
# WORKER_DELIVERY_REFRESH_INTERVAL_MS=600000
# WORKER_DELIVERY_REFRESH_LIMIT=200
# WORKER_SCHEDULES_INTERVAL_MS=300000
# WORKER_SHUTDOWN_TIMEOUT_MS=25000
# WORKER_STUCK_MS=1800000
# WORKER_HEALTH_PORT=3003
# WORKER_HEALTH_HOST=127.0.0.1
# WORKER_DB_POOL_MAX=4

# Encrypts delivery credentials (Jira API tokens). Falls back to a key derived
# from BETTER_AUTH_SECRET when empty. Rotating it invalidates stored tokens.
DELIVERY_CREDENTIALS_KEY=

# Lictory AI (optional). Organizations must still opt in. See docs/internals/ai.md.
OPENAI_API_KEY=
LICTORY_AI_MODEL=gpt-6-luna
# Live dictation in the Intelligence composer.
LICTORY_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Private attachment storage, optional (without it attachments are disabled).
# These values match the MinIO service in compose.yaml. For any other
# S3-compatible service set the same variables; for AWS S3 leave S3_ENDPOINT
# empty and set S3_REGION. Browsers upload and download directly against
# S3_ENDPOINT through short-lived signed URLs. See docs/internals/file-storage.md.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=
S3_BUCKET=lictory-files
S3_ACCESS_KEY_ID=lictory
S3_SECRET_ACCESS_KEY=lictory-development
# Defaults to true when S3_ENDPOINT is set (bucket in the path, not the host).
S3_FORCE_PATH_STYLE=
# Cloudflare R2 preset, instead of every S3_* value above (setting both is an
# error). Use a bucket-scoped R2 API token with object read/write access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional for R2 jurisdiction-specific S3 endpoints (not a public domain).
R2_S3_ENDPOINT=

# Optional PostHog product analytics. POSTHOG_* configure the application at
# runtime (API, worker and the platform document); the website embeds its
# NEXT_PUBLIC_* copies at build time. Browsers reach PostHog through the
# first-party /relay route: full tracking with analytics consent, cookieless
# anonymous tracking without it (enable "Cookieless server hash mode" in
# PostHog). Use your project's ingestion host; see docs/internals/analytics.md.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# `strict`: no analytics before consent, browser or server; unset keeps
# cookieless anonymous analytics before consent.
ANALYTICS_CONSENT=
NEXT_PUBLIC_ANALYTICS_CONSENT=

# Application
BETTER_AUTH_URL=http://localhost:3000
# Generate a production value with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-secret-change-before-production

# PostgreSQL (host value; Compose overrides this for the app container)
DATABASE_URL=postgresql://lictory:lictory@localhost:5432/lictory
# Direct PostgreSQL connection for LISTEN/NOTIFY and migrations when the main
# URL is transaction-pooled (Neon's Vercel integration provides this value).
# Leave empty locally to use DATABASE_URL for both.
DATABASE_URL_UNPOOLED=

# Transactional email. When RESEND_API_KEY is empty, local development falls
# back to the SMTP settings below and Mailpit captures every message.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lictory <no-reply@email.lictory.com>

# Local SMTP fallback (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Lictory <no-reply@lictory.local>

# OAuth providers are optional. Their buttons become active when both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Scheduled jobs (automatic cycles). POST /api/jobs/iterations with
# "Authorization: Bearer $CRON_SECRET" from Trigger.dev or another scheduler,
# or run `bun scripts/iteration-worker.ts`. Leave empty to disable the route.
CRON_SECRET=

# Encrypts delivery credentials (Jira API tokens). Falls back to a key derived
# from BETTER_AUTH_SECRET when empty. Rotating it invalidates stored tokens.
DELIVERY_CREDENTIALS_KEY=

# Private Cloudflare R2 bucket. Create a bucket-scoped R2 API token with object
# read/write access. The S3 endpoint is used for signed uploads and downloads;
# public access and a custom domain must stay disabled for tenant files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional for R2 jurisdiction-specific S3 endpoints (not a public domain).
R2_S3_ENDPOINT=

# Optional PostHog product analytics (browser + server). Set before building.
# Use your project's ingestion host; see docs/analytics.md for the event catalog.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

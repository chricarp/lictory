{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lictory-marketing",
  "main": "../../deploy/cloudflare/src/worker.ts",
  "compatibility_date": "2026-10-22",
  "routes": [
    { "pattern": "lictory.com/*", "zone_name": "lictory.com" },
    { "pattern": "www.lictory.com/*", "zone_name": "lictory.com" },
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "vars": {
    "SITE_KIND": "marketing",
    "SITE_URL": "https://lictory.com",
  },
  // POSTHOG_HOST, for the analytics relay, comes from the deployment
  // (`wrangler deploy --var`); without it /relay answers 404.
}

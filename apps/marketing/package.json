{
  "name": "@lictory/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-shared-assets.mjs",
    "dev": "node scripts/copy-shared-assets.mjs && next dev --port 3100",
    "build": "node scripts/copy-shared-assets.mjs && next build --webpack",
    "build:cloudflare": "MARKETING_STATIC_EXPORT=true bun run build",
    "preview:cloudflare": "wrangler dev --port 8787",
    "deploy:cloudflare": "wrangler deploy",
    "start": "next start --port ${PORT:-3100}",
    "typecheck": "next typegen && tsc --noEmit -p ."
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^14.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}

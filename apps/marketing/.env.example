# Public website (lictory.com). Copy to apps/marketing/.env.local for local
# overrides. Every value here is read at build time: the pages are prerendered
# and NEXT_PUBLIC_ variables are embedded in the bundles, so rebuild after
# changing any of them. The website needs no database or auth configuration.

# Canonical origin for metadata, sitemap, feeds and social card URLs.
# Set it for production builds; unset falls back to http://localhost:3100.
SITE_URL=

# The website operator's identity and contact, shown on the legal pages.
# Without a name and email the pages display a draft notice; the postal
# address is optional. These values are publicly displayed: keep them out of
# the repository (for lictory.com they are variables of the GitHub
# environment `websites`). See docs/operations/legal.md.
LICTORY_LEGAL_NAME=
LICTORY_LEGAL_ADDRESS=
LICTORY_LEGAL_EMAIL=
# Optional: VAT / company or professional registration details, if applicable.
LICTORY_LEGAL_REGISTRATION=

# Optional PostHog analytics through the first-party /relay route; leave the
# token empty to disable it. See docs/internals/analytics.md.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

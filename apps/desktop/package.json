{
  "name": "@lictory/desktop",
  "productName": "Lictory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Lictory desktop app for self-hosted Lictory servers.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && electron .",
    "setup": "install-electron",
    "package": "node build.mjs && node package.mjs",
    "test:smoke": "playwright test -c playwright.config.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "homepage": "https://lictory.com",
  "author": "Lictory contributors"
}

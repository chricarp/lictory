{
  "name": "@lictory/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-shared-assets.mjs && next dev --port 3200",
    "build": "node scripts/copy-shared-assets.mjs && next build --webpack && bun ../../scripts/check-site-indexing.ts out",
    "build:cloudflare": "bun run build",
    "preview:cloudflare": "wrangler dev --port 8788",
    "deploy:cloudflare": "wrangler deploy",
    "typecheck": "next typegen && tsc --noEmit -p ."
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.47.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/mdx": "2.0.14",
    "wrangler": "4.154.0"
  },
  "license": "MIT"
}

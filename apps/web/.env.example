NEXT_PUBLIC_API_URL=https://api.lictory.localhost

# Required on the deployed web Worker so iOS and Android can verify that the
# native app is allowed to use passkeys for lictory.com.
APPLE_TEAM_ID=
APPLE_APP_BUNDLE_IDENTIFIER=com.lictory.app
ANDROID_APP_PACKAGE=com.lictory.app
# Comma-separated colon-delimited SHA-256 signing certificate fingerprints.
ANDROID_SHA256_CERT_FINGERPRINTS=

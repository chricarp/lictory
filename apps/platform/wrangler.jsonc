{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lictory-platform",
  "main": "../../deploy/cloudflare/src/worker.ts",
  "compatibility_date": "2026-10-22",
  "routes": [{ "pattern": "app.lictory.com/*", "zone_name": "lictory.com" }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "SITE_KIND": "platform",
    "SITE_URL": "https://lictory.com",
    "PLATFORM_URL": "https://app.lictory.com",
    "BACKEND_ORIGIN": "https://app.lictory.com",
  },
}
